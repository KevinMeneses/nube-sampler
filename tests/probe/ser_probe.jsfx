desc:Nube Sampler - sonda de serializacion (pruebas)
slider1:0<0,20000000,1>-Frames a guardar
slider2:0<-1000000000,1000000000,0.001>-Error maximo x1e6 (lectura)
slider3:0<0,20000000,1>-Frames leidos (lectura)
options:maxmem=33554432
@init
ext_noinit = 1;
@serialize
file_avail(0) < 0 ? (
  n = slider1; i = 0; s = 0; loop(n * 2, M[i] = sin(i * 0.37) * 0.5; i += 1; );
  file_var(0, n); file_mem(0, M, n * 2);
) : (
  n = 0; file_var(0, n); file_mem(0, M, n * 2);
  s = 0; i = 0; loop(n * 2, d = abs(M[i] - sin(i * 0.37) * 0.5); d > s ? s = d; i += 1; );
  slider2 = s * 1000000; slider3 = n;
);
