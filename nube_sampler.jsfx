// ---------------------------------------------------------------- presets
function preset_name(n)
(
  n == 1 ? "Clasico - Instrumento" :
  n == 2 ? "Clasico - 808 con glide" :
  n == 3 ? "Clasico - Pad (loop ping-pong)" :
  n == 4 ? "Clasico - Textura estirada" :
  n == 5 ? "One-shot - Bateria" :
  n == 6 ? "One-shot - Cromatico" :
  n == 7 ? "Chops - Transitorios (MPC)" :
  n == 8 ? "Chops - 16 partes iguales" :
  n == 9 ? "Chops - Vocal (mantener)" :
  n == 10 ? "Chops - A tempo (estirar)" :
  n == 11 ? "Loop - A tempo (estirar)" :
  n == 12 ? "Loop - Vinilo a tempo" :
  n == 13 ? "Lo-fi - SP 12 bits" :
