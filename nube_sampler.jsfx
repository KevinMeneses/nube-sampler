function fig_beats(n) (
  n == 1 ? 0.125 : n == 2 ? 0.166667 : n == 3 ? 0.25 : n == 4 ? 0.333333 : n == 5 ? 0.375 : n == 6 ? 0.5 :
  n == 7 ? 0.666667 : n == 8 ? 0.75 : n == 9 ? 1 : n == 10 ? 1.333333 : n == 11 ? 1.5 : n == 12 ? 2 : n == 13 ? 3 :
  n == 14 ? 4 : n == 15 ? 8 : 16;
);
function fig_name(n) (
  n == 1 ? "1/32" : n == 2 ? "1/16 T" : n == 3 ? "1/16" : n == 4 ? "1/8 T" : n == 5 ? "1/16 ." : n == 6 ? "1/8" :
  n == 7 ? "1/4 T" : n == 8 ? "1/8 ." : n == 9 ? "1/4" : n == 10 ? "1/2 T" : n == 11 ? "1/4 ." : n == 12 ? "1/2" :
  n == 13 ? "1/2 ." : n == 14 ? "1 compas" : n == 15 ? "2 compases" : "4 compases";
);
// "A tempo": cuantos tiempos (negras) dura la region
function sync_beats(n) ( n == 1 ? 1 : n == 2 ? 2 : n == 3 ? 4 : n == 4 ? 8 : n == 5 ? 16 : n == 6 ? 32 : 64; );
function sync_name(n) ( n == 0 ? "Apagado" : n == 1 ? "1 tiempo" : n == 2 ? "2 tiempos" : n == 3 ? "1 compas" : n == 4 ? "2 compases" :
  n == 5 ? "4 compases" : n == 6 ? "8 compases" : "16 compases"; );

// ---------------------------------------------------------------- lectura del sample
function bessel_i0(x) local(s, t, k)
( s = 1; t = 1; k = 1; loop(40, t *= (x / (2 * k)) * (x / (2 * k)); s += t; k += 1; ); s; );
function sinc_init() local(i, t, x, w, fc, beta, i0b)
(
  fc = 0.97; beta = 8; i0b = bessel_i0(beta); i = 0;
  loop(2 * SKW * SKR + 4,
    t = i / SKR - SKW;
    x = $pi * fc * t;
    w = abs(t) < SKW ? bessel_i0(beta * sqrt(1 - (t / SKW) * (t / SKW))) / i0b : 0;
    SKT[i] = (abs(x) < 0.0000001 ? fc : fc * sin(x) / x) * w;
    i += 1;
  );
);
// muestra entera fuera de rango = 0
function smp_at(i, c) ( (i >= 0 && i < SN) ? SMP[2 * i + c] : 0; );
// Hermite de 4 puntos (exacta en posiciones enteras): deja el resultado en RL / RR
function rd_herm(p) local(i, f, j, x0, x1, x2, x3, y0, y1, y2, y3)
(
  i = floor(p); f = p - i;
  (i >= 1 && i + 2 < SN) ? (
    j = SMP + 2 * i;
    x0 = j[-2]; x1 = j[0]; x2 = j[2]; x3 = j[4];
    y0 = j[-1]; y1 = j[1]; y2 = j[3]; y3 = j[5];
  ) : (
    x0 = smp_at(i - 1, 0); x1 = smp_at(i, 0); x2 = smp_at(i + 1, 0); x3 = smp_at(i + 2, 0);
    y0 = smp_at(i - 1, 1); y1 = smp_at(i, 1); y2 = smp_at(i + 1, 1); y3 = smp_at(i + 2, 1);
  );
  f == 0 ? ( RL = x1; RR = y1; ) : (
    RL = ((((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1);
    RR = ((((0.5 * (y3 - y0) + 1.5 * (y1 - y2)) * f + (y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3)) * f + 0.5 * (y2 - y0)) * f + y1);
  );
);
// sinc con antialiasing: si la lectura avanza r > 1 muestras por salida, el corte baja a 0.97/r (hasta r = 4).
// La tabla tiene 2048 fases por muestra: se lee la fase mas cercana (el indice avanza sumando, sin recalcular).
function rd_sinc(p, r) local(s, i, f, n, j, x, dx, h, e, acl, acr)
(
  s = r > 1 ? 1 / min(r, 4) : 1;
  i = floor(p); f = p - i;
  n = ceil(SKW / s);
  acl = acr = 0;
  x = ((1 - n - f) * s + SKW) * SKR + 0.5; dx = s * SKR;
  j = i + 1 - n;
  (j >= 0 && i + n < SN) ? (
    e = SMP + 2 * j;
    s == 1 ? loop(2 * n, h = SKT[x]; acl += e[0] * h; acr += e[1] * h; e += 2; x += dx; )
           : loop(2 * n, (x >= 0 && x < SKN) ? ( h = SKT[x]; acl += e[0] * h; acr += e[1] * h; ); e += 2; x += dx; );
  ) : (
    loop(2 * n, (j >= 0 && j < SN && x >= 0 && x < SKN) ? ( h = SKT[x]; acl += SMP[2 * j] * h; acr += SMP[2 * j + 1] * h; ); j += 1; x += dx; );
  );
  RL = acl * s; RR = acr * s;
);
function rd(p, r) ( QUAL ? rd_sinc(p, r) : rd_herm(p); );

// ---------------------------------------------------------------- voces
// vb[0] activa, 1 nota, 2 velocidad, 3 gate, 4 edad, 5 posicion u (o puntero de analisis al estirar), 6 sentido ping-pong,
// 8 b0 / 9 b1 (region en frames del archivo), 10 reverso, 11 loop inicio u, 12 loop fin u, 13 loop (0/1/2),
// 14 env amp, 15 etapa amp, 16 env 2, 17 etapa env 2, 18 sostenida por pedal, 19 chop (-1 clasico, -2 escucha),
// 20 ganancia, 21 avance por muestra (o razon de tono al estirar), 22 glide desde (st), 23 glide hacia, 24 glide 0..1,
// 25 glide por muestra, 26..33 filtro, 34 g, 35 dg, 36 g objetivo, 37 octavas por velocidad, 38 fundido de corte,
// 39 largo de la region (u), 40 one-shot, 41 grano 0 pos, 42 grano 0 t, 43 grano 1 pos, 44 grano 1 t,
// 45 tono actual (st), 46 corte actual, 47 crossfade (u), 48 fade in, 49 fade out, 50 grano (muestras), 51 posicion para dibujar,
// 52 frames leidos (para el fade in), 53 avance del analisis al estirar, 54 frecuencia del sample / srate,
// 55 zona (-1 sin zona), 56 nota raiz de la voz, 57 paso de la relajacion lineal
// u = posicion dentro de la region, en el sentido de la lectura (con reverso, u = 0 es el final de la region)
function vread(vb, u, r) local(ll)
(
  (vb[13] == 1 && u >= vb[12]) ? ( ll = vb[12] - vb[11]; u = vb[11] + (u - vb[11]) - ll * floor((u - vb[11]) / ll); );
  (u < 0 || u >= vb[39]) ? ( RL = RR = 0; ) : rd(vb[10] ? vb[9] - 1 - u : vb[8] + u, r);
);
function mono_at(vb, u) local(ll, i)
(
  (vb[13] == 1 && u >= vb[12]) ? ( ll = vb[12] - vb[11]; u = vb[11] + (u - vb[11]) - ll * floor((u - vb[11]) / ll); );
  (u < 0 || u >= vb[39]) ? 0 : ( i = floor(vb[10] ? vb[9] - 1 - u : vb[8] + u); SMP[2 * i] + SMP[2 * i + 1]; );
);
// WSOLA: busca cerca de a el inicio del grano nuevo que mejor continua al grano que esta sonando (posicion c).
// La zona de busqueda se lee una vez a WSM (mono) y la correlacion (32 puntos) se hace desde ahi.
function wsola(vb, a, c, p) local(d, j, s, s0, s1, nm, best, bs, xy, yy, y, score, e, k, m)
(
  d = max(1, floor(p * 4 + 0.5));
  j = 0; e = 0; loop(32, WSX[j] = mono_at(vb, c + j * d); e += WSX[j] * WSX[j]; j += 1; );
  best = a;
  e > 0.00000001 ? (
    s0 = max(0, floor(a - WS_T)); s1 = floor(a + WS_T);
    nm = min(s1 - s0 + 31 * d + 3, 9000); s1 = min(s1, s0 + nm - 31 * d - 3);
    k = 0; loop(nm, WSM[k] = mono_at(vb, s0 + k); k += 1; );
    bs = -1000000000; s = s0;
    while (s <= s1) (
      m = WSM + (s - s0); xy = yy = 0; j = 0;
      loop(32, y = m[j * d]; xy += WSX[j] * y; yy += y * y; j += 1; );
      score = xy / sqrt(yy + 0.00000001) - abs(s - a) * 0.0000001;
      score > bs ? ( bs = score; best = s; );
      s += 3;
    );
    s = max(s0, best - 2); s1 = min(s1 + 2, best + 2);
    while (s <= s1) (
      m = WSM + (s - s0); xy = yy = 0; j = 0;
      loop(32, y = m[j * d]; xy += WSX[j] * y; yy += y * y; j += 1; );
      score = xy / sqrt(yy + 0.00000001) - abs(s - a) * 0.0000001;
      score > bs ? ( bs = score; best = s; );
      s += 1;
    );
  );
  best;
);

function update_speed()
(
  SPEED = (SYNCN > 0 && !ZONES && R1 > R0 && SSR > 0) ? ((R1 - R0) / SSR) / (sync_beats(SYNCN) * 60 / max(tempo, 20)) : slider18 / 100;
  last_tempo = tempo;
);

// trozos por transitorios: energia de la derivada por bloque (ODF, en dB); un golpe = subida de mas de umbral dB
function refine_onset(h) local(i0, i1, i, e, k, mx, pv, x, d, best)
(
  i0 = max(0, (h - 2) * HOP); i1 = min(SN - 1, (h + 1) * HOP);
  mx = 0; i = i0; pv = SMP[2 * i] + SMP[2 * i + 1];
  // energia en ventanas de 16 muestras
  while (i + 16 <= i1) (
    e = 0; k = 0; loop(16, x = SMP[2 * (i + k)] + SMP[2 * (i + k) + 1]; d = x - pv; pv = x; e += d * d; k += 1; );
    e > mx ? mx = e; i += 16;
  );
  best = h * HOP; i = i0; pv = SMP[2 * i] + SMP[2 * i + 1];
  while (i + 16 <= i1) (
    e = 0; k = 0; loop(16, x = SMP[2 * (i + k)] + SMP[2 * (i + k) + 1]; d = x - pv; pv = x; e += d * d; k += 1; );
    e >= mx * 0.2 ? ( best = i; i = i1; ) : i += 16;
  );
  max(0, best - floor(SSR * 0.0005));
);
function detect_chops() local(k, p, h, h0, h1, mx, mxp, gate, thr, gapb, last, rise, rise2, gapf)
(
  NCH = 0;
  (LOADED && R1 > R0 + 64) ? (
    CHP[0] = R0; NCH = 1; gapf = floor(0.03 * SSR);
    CDET == 1 ? (
      k = 1; loop(NPARTS - 1, CHP[NCH] = floor(R0 + (R1 - R0) * k / NPARTS); NCH += 1; k += 1; );
    ) : CDET == 2 ? (
      k = 0;
      loop(NMAN,
        p = floor(MANP[k] * SN);
        (p > CHP[NCH - 1] + 32 && p < R1 - 32 && NCH < MAXCH) ? ( CHP[NCH] = p; NCH += 1; );
        k += 1;
      );
    ) : (
      thr = 1.5 + (100 - SENS) * 0.12; gapb = ceil(0.06 * SSR / HOP);
      h0 = max(6, ceil(R0 / HOP)); h1 = min(NODF - 1, floor(R1 / HOP));
      mx = -300; h = h0; loop(max(0, h1 - h0), mx = max(mx, ODF[h]); h += 1; );
      gate = mx - 30 - SENS * 0.3;
      last = -1000; h = h0;
      while (h < h1 && NCH < MAXCH) (
        // subida contra el maximo de los ultimos 6 bloques (~16 ms): las colas de un golpe no cuentan como golpes nuevos
        mxp = ODF[h - 1]; k = 2; loop(5, mxp = max(mxp, ODF[h - k]); k += 1; );
        rise = ODF[h] - mxp; rise2 = ODF[h + 1] - max(mxp, ODF[h]);
        (rise > thr && ODF[h] > gate && rise >= rise2 && h - last >= gapb) ? (
          p = refine_onset(h);
          (p > CHP[NCH - 1] + gapf && p < R1 - gapf) ? ( CHP[NCH] = p; NCH += 1; last = h; );
        );
        h += 1;
      );
      // si el primer golpe esta muy cerca del inicio, el primer chop empieza en el golpe (sin el silencio previo)
      (NCH >= 2 && CHP[1] - R0 < 0.1 * SSR) ? ( k = 1; loop(NCH - 1, CHP[k - 1] = CHP[k]; k += 1; ); NCH -= 1; );
    );
    CHP[NCH] = R1;
  );
  slider162 = NCH;
  CHVER += 1;
);

// bytes del audio guardado en el proyecto (S16: empaquetado de 16 bits, ver ser_write_audio)
function emb_bytes() ( (slider62 && LOADED) ? (S16 ? ceil(SN * 2 / 3) * 2 * 4 : SN * 2 * 4) : 0; );
function update_params() local(i, sig)
(
  CHOPS = slider2 == 1; ZONES = slider2 == 2; ONESHOT = slider3; STRETCH = slider4;
  R0 = floor(clamp(slider5, 0, 100) / 100 * SN); R1 = floor(clamp(slider6, 0, 100) / 100 * SN);
  R1 < R0 + 2 ? R1 = min(SN, R0 + 2);
  REVG = slider7; LOOPM = slider8;
  LPS = floor(slider9 / 100 * SN); LPE = floor(slider10 / 100 * SN);
  XFS = slider11 / 1000 * SSR; FINF = slider12 / 1000 * SSR; FOUTF = slider13 / 1000 * SSR;
  ROOT = slider14; KTRK = slider15; TONEG = slider16 + slider17 / 100;
  SYNCN = slider19;
  GRAINS = max(32, floor(slider20 / 1000 * srate));
  WS_T = floor(min(0.012, slider20 / 1000 * 0.25) * SSR);
  QUAL = slider21; CDET = slider22; SENS = slider23; NPARTS = slider24; CHB = slider25;
  PLAYTHRU = slider26; CHOKE = slider27;
  VMODE = slider28; NV = slider29; GLIDE = slider30; BEND_R = slider31; VIBC = slider32 / 100;
  AE_INC = slider33 > 0 ? 1 / max(1, slider33 * srate / 1000) : 1;
  AE_DC = exp(-4.605170186 / max(1, slider34 * srate / 1000));
  AE_S = slider35 / 100; AE_RC = exp(-4.605170186 / max(1, slider36 * srate / 1000)); VVOL = slider37 / 100;
  AE_FREE = AE_S < 0.0001; RLIN = slider167;
  FT = slider38; CUT = slider39; KRES = 1.41421356 * (1 - 0.985 * slider40 / 100);
  DRV = 10 ^ (slider41 / 20); DRVC = 1 / sqrt(DRV); E2_CUT = slider42 / 100 * 8;
  EE_INC = slider43 > 0 ? 1 / max(1, slider43 * srate / 1000) : 1;
  EE_DC = exp(-4.605170186 / max(1, slider44 * srate / 1000));
  EE_S = slider45 / 100; EE_RC = exp(-4.605170186 / max(1, slider46 * srate / 1000)); E2_TONO = slider47;
  KT = slider48 / 100; VCUT = slider49 / 100;
  LFS = slider50; LFD = slider53; LFA = slider54 / 100; LFRT = slider55;
  LFRATE = slider52 > 0 ? max(tempo, 20) / 60 / fig_beats(slider52) : slider51;
  BITS = slider56; LSR = slider57; LFI_SR = LSR < min(47999, srate * 0.999);
  PANB = slider58 / 100; WIDTH = slider59 / 100; VOLG = 10 ^ (slider60 / 20);
  NORMG = (slider61 && SPEAK > 0.000001) ? 1 / SPEAK : 1;
  SRR = SSR > 0 ? SSR / srate : 1;
  KILLN = max(8, floor(0.003 * srate));
  i = 0; loop(MAXCH, CTN[i] = slider(CHOP0 + 3 * i); CGN[i] = 10 ^ (slider(CHOP0 + 3 * i + 1) / 20); CRV[i] = slider(CHOP0 + 3 * i + 2); i += 1; );
  LVOL = LFD == 2 && LFA != 0; LPAN = LFD == 3 && LFA != 0;
  update_speed();
  slider165 = floor(emb_bytes() * 4 / 3 / 100000 + 0.5) / 10;     // en el .rpp va en base64 (4/3)
  sig = SN * 3 + R0 * 7 + R1 * 13 + CDET * 1000003 + SENS * 17 + NPARTS * 101 + MANVER * 7919;
  sig != LAST_SIG ? ( LAST_SIG = sig; detect_chops(); );
);

// ---------------------------------------------------------------- carga del sample
function is_16bit() local(i, x, ok)
( ok = 1; i = 0; while (ok && i < SN * 2) ( x = SMP[i] * 32768; (x != floor(x) || x < -32768 || x > 32767) ? ok = 0; i += 1; ); ok; );
// raiz por YIN sobre un tramo del medio (sin transitorio)
// nota de un tramo: frames DB .. DB + DN de SMP, a DSR Hz (-1 = sin nota clara)
function detect_note() local(w, maxlag, minlag, s0, tau, j, d, x, sum, dnm, best, found, a, b, c, den, f, en, bd, res)
(
  res = -1;
  w = floor(2048 * DSR / 48000); maxlag = floor(DSR / 40); minlag = max(2, floor(DSR / 2500));
  s0 = max(floor(DSR * 0.05), floor(DN * 0.15));
  s0 + w + maxlag + 2 > DN ? s0 = DN - w - maxlag - 2;
  s0 >= 0 ? (
    s0 += DB;
    en = 0; j = 0; loop(w, x = SMP[2 * (s0 + j)] + SMP[2 * (s0 + j) + 1]; en += x * x; j += 1; );
    en > w * 0.00001 ? (
      sum = 0; tau = 1; found = 0; best = 0;
      while (tau <= maxlag && !found) (
        d = 0; j = 0;
        loop(w, x = (SMP[2 * (s0 + j)] + SMP[2 * (s0 + j) + 1]) - (SMP[2 * (s0 + j + tau)] + SMP[2 * (s0 + j + tau) + 1]); d += x * x; j += 1; );
        sum += d; dnm = d * tau / max(sum, 0.0000000001);
        (tau >= minlag && dnm < 0.12) ? (
          // baja hasta el minimo local
          best = tau; bd = d;
          tau += 1;
          d = 0; j = 0;
          loop(w, x = (SMP[2 * (s0 + j)] + SMP[2 * (s0 + j) + 1]) - (SMP[2 * (s0 + j + tau)] + SMP[2 * (s0 + j + tau) + 1]); d += x * x; j += 1; );
          while (d < bd && tau < maxlag) (
            best = tau; bd = d; tau += 1;
            d = 0; j = 0;
            loop(w, x = (SMP[2 * (s0 + j)] + SMP[2 * (s0 + j) + 1]) - (SMP[2 * (s0 + j + tau)] + SMP[2 * (s0 + j + tau) + 1]); d += x * x; j += 1; );
          );
          // parabola con los vecinos best-1, best, best+1
          a = 0; j = 0; tau = best - 1;
          loop(w, x = (SMP[2 * (s0 + j)] + SMP[2 * (s0 + j) + 1]) - (SMP[2 * (s0 + j + tau)] + SMP[2 * (s0 + j + tau) + 1]); a += x * x; j += 1; );
          b = bd; c = d;
          den = a - 2 * b + c;
          f = best + (abs(den) > 0.0000000001 ? 0.5 * (a - c) / den : 0);
          res = 69 + 12 * log(DSR / f / 440) / log(2);
          found = 1;
        ) : tau += 1;
      );
    );
  );
  res;
);
function detect_root()
(
  DB = 0; DN = SN; DSR = SSR; DET_NOTE = detect_note();
  slider163 = DET_NOTE < 0 ? -1 : floor(DET_NOTE * 100 + 0.5) / 100;
);
function after_load() local(i, m, x, h, e, pv, d, k)
(
  m = 0; i = 0; loop(SN * 2, x = abs(SMP[i]); x > m ? m = x; i += 1; );
  SPEAK = m;
  // resumen para dibujar
  k = SN / PKN; h = 0;
  loop(PKN,
    i = floor(h * k); e = max(i + 1, floor((h + 1) * k)); e > SN ? e = SN;
    d = max(1, floor((e - i) / 256)); m = 0; pv = 0;
    while (i < e) ( x = SMP[2 * i]; x < pv ? pv = x; x > m ? m = x; x = SMP[2 * i + 1]; x < pv ? pv = x; x > m ? m = x; i += d; );
    PKL[h] = pv; PKH[h] = m; h += 1;
  );
  // energia de la derivada por bloque
  HOP = max(128, ceil(SN / MAXODF)); NODF = floor(SN / HOP); h = 0; pv = 0;
  loop(NODF,
    e = 0; i = h * HOP;
    loop(HOP, x = SMP[2 * i] + SMP[2 * i + 1]; d = x - pv; pv = x; e += d * d; i += 1; );
    ODF[h] = 10 * log10(e / HOP + 0.0000000001); h += 1;
  );
  ODF[NODF] = ODF[NODF + 1] = -100;
  detect_root();
  S16 = is_16bit();
  LOADED = SN > 1; LOADING = 0;
  slider161 = SN;
  VZ0 = 0; VZ1 = SN; WAVEVER += 1;
  LAST_SIG = -1; update_params();
);
function all_kill_now() local(v) ( v = 0; loop(MAXV, (V0 + v * VS)[0] = 0; v += 1; ); NS = 0; MV = -1; );
// lee un archivo abierto a SMP desde el frame off (hasta maxf frames). Deja RD_NC, RD_SR, RD_LONG (no cupo entero).
// Devuelve los frames leidos (0 = no es audio). Mata las voces antes de escribir.
function read_into(h, off, mf) local(nc, sr, avail, fr, n, i, k, tf, d)
(
  nc = 0; sr = 0; fr = 0;
  file_riff(h, nc, sr);
  (nc >= 1 && sr >= 1) ? (
    avail = file_avail(h);
    fr = min(floor(avail / nc), mf);
    fr > 1 ? (
      LOADING = 1; all_kill_now();
      tf = floor(TMPN / nc); k = 0;
      while (k < fr) (
        n = min(tf, fr - k);
        file_mem(h, TMP, n * nc);
        i = 0; d = SMP + 2 * (off + k);
        nc == 1 ? loop(n, d[2 * i] = d[2 * i + 1] = TMP[i]; i += 1; )
                : loop(n, d[2 * i] = TMP[i * nc]; d[2 * i + 1] = TMP[i * nc + 1]; i += 1; );
        k += n;
      );
      RD_NC = nc; RD_SR = sr; RD_LONG = floor(avail / nc) > mf;
    ) : fr = 0;
  );
  fr;
);
function load_handle(h) local(fr, ok)
(
  ok = 0;
  fr = read_into(h, 0, MAXF);
  fr > 1 ? (
    LOADED = 0; ZN = 0; slider164 = 0;
    SN = fr; SNCH = RD_NC; SSR = RD_SR; SLONG = RD_LONG;
    after_load(); ok = 1;
  ) : LOADING = 0;
  ok;
);
// nombre para mostrar: lo que va despues de la ultima "/" y sin la extension
function set_name(src) local(i, n, c, sl, dot)
(
  n = strlen(src); sl = -1; dot = n; i = 0;
  loop(n, c = str_getchar(src, i); c == '/' ? ( sl = i; dot = n; ); c == '.' ? dot = i; i += 1; );
  strcpy_substr(#sname, src, sl + 1, dot - sl - 1);
);
// si no se puede abrir el sample del selector: falta la biblioteca (enlace roto de install.sh) o el archivo
function load_slider() local(h, ok)
(
  ok = 0;
  h = file_open(slider1);
  h >= 0 ? ( ok = load_handle(h); file_close(h); );
  ok ? ( SRC_KIND = 1; strcpy_fromslider(#spath, slider1); set_name(#spath); MISSING = 0; LIBMISS = 0; )
     : ( strcpy_fromslider(#libpath, slider1); LIBMISS = h < 0 ? (strlen(#libpath) ? 1 : 2) : 3; );
  LAST_SL = slider1;
  ok;
);
// nombre para mostrar con zonas: "ep_036 ... ep_084 (17 zonas)"
function zone_name() local(a)
(
  ZN > 0 ? (
    set_name(ZSTR); strcpy(#_za, #sname);
    ZN > 1 ? ( set_name(ZSTR + ZN - 1); strcat(#_za, " ... "); strcat(#_za, #sname); );
    sprintf(#_zb, " (%d zonas)", ZN); strcat(#_za, #_zb); strcpy(#sname, #_za);
  );
);
function zones_loaded() ( ZN > 0 ? ( zone_name(); LIBMISS = 0; MISSING = 0; sset(2, 2); update_params(); ); );
function load_path(p) local(h, ok)
(
  ok = 0;
  h = file_open(p);
  h >= 0 ? ( ok = load_handle(h); file_close(h); );
  ok ? ( SRC_KIND = 2; strcpy(#spath, p); set_name(#spath); MISSING = 0; );
  ok;
);

// ---------------------------------------------------------------- zonas
// nota en el nombre del archivo: "ep_048.wav" -> 48, "Rhodes C4.wav" -> 60, "Pad F#3" / "Pad Gb3" -> 54 (C4 = 60).
// Deja en NM_A / NM_B donde empieza y termina el pedazo de la nota en el nombre (para buscar los hermanos), NM_KIND
// 1 = numero (NM_W cifras), 2 = nombre de nota. -1 si no hay.
function name_note(str) local(n, sl, dot, i, c, c2, e, b, v, pc, acc, k, neg)
(
  n = strlen(str); sl = -1; dot = n; i = 0;
  loop(n, c = str_getchar(str, i); c == '/' ? ( sl = i; dot = n; ); c == '.' ? dot = i; i += 1; );
  // ultimo grupo de cifras antes de la extension
  e = dot - 1; while (e > sl && !(str_getchar(str, e) >= '0' && str_getchar(str, e) <= '9')) ( e -= 1; );
  v = -1; NM_KIND = 0;
  e > sl ? (
    b = e; while (b - 1 > sl && str_getchar(str, b - 1) >= '0' && str_getchar(str, b - 1) <= '9') ( b -= 1; );
    k = 0; i = b; loop(e - b + 1, k = k * 10 + str_getchar(str, i) - '0'; i += 1; );
    neg = b - 1 > sl && str_getchar(str, b - 1) == '-';
    i = neg ? b - 2 : b - 1;
    acc = 0; c = i > sl ? str_getchar(str, i) : 0;
    (c == '#' || c == 'b') && i - 1 > sl ? (
      c2 = str_getchar(str, i - 1);
      ((c2 >= 'A' && c2 <= 'G') || (c2 >= 'a' && c2 <= 'g')) ? ( acc = c == '#' ? 1 : -1; i -= 1; c = c2; );
    );
    c >= 'a' && c <= 'g' ? c -= 32;
    pc = c == 'C' ? 0 : c == 'D' ? 2 : c == 'E' ? 4 : c == 'F' ? 5 : c == 'G' ? 7 : c == 'A' ? 9 : c == 'B' ? 11 : -1;
    // letra de nota suelta (al inicio o despues de algo que no es letra): nombre de nota
    (pc >= 0 && (i - 1 <= sl || !((str_getchar(str, i - 1) >= 'A' && str_getchar(str, i - 1) <= 'Z') || (str_getchar(str, i - 1) >= 'a' && str_getchar(str, i - 1) <= 'z')))) ? (
      v = ((neg ? -k : k) + 1) * 12 + pc + acc; NM_KIND = 2; NM_A = i; NM_B = e + 1;
    ) : (
      v = k; NM_KIND = 1; NM_A = b; NM_B = e + 1; NM_W = e - b + 1;
    );
    (v < 0 || v > 127) ? ( v = -1; NM_KIND = 0; );
  );
  v;
);
function zone_end() local(z) ( ZN > 0 ? ( z = ZT + (ZN - 1) * ZF; z[0] + z[1]; ) : 0; );
// agrega el archivo p como zona (raiz = nota del nombre, o detectada; si no hay, 60). 1 = ok, 0 = no es audio, -1 = no cabe
function zone_add(p) local(h, off, fr, z, nn, i, r)
(
  r = 0;
  ZN < MAXZ ? (
    off = zone_end() + PADZ;
    off + PADZ + 1024 > MAXF ? r = -1 : (
      h = file_open(p);
      h >= 0 ? (
        fr = read_into(h, off, MAXF - off - PADZ);
        file_close(h);
        fr > 1 ? (
          i = 0; loop(2 * PADZ, SMP[2 * (off - PADZ) + i] = SMP[2 * (off + fr) + i] = 0; i += 1; );
          z = ZT + ZN * ZF;
          z[0] = off; z[1] = fr; z[3] = 0; z[4] = 127; z[5] = 1; z[6] = 127; z[7] = RD_SR; z[8] = RD_NC; z[9] = 0;
          nn = name_note(p); z[10] = nn;
          nn < 0 ? ( DB = off; DN = fr; DSR = RD_SR; nn = detect_note();
                     nn >= 0 ? ( z[9] = floor((nn - floor(nn + 0.5)) * 100 + 0.5); nn = floor(nn + 0.5); ) : nn = 60; );
          z[2] = clamp(nn, 0, 127);
          strcpy(ZSTR + ZN, p);
          ZN += 1; RD_LONG ? ZCUT += 1;
          r = 1;
        );
      );
    );
  ) : r = -1;
  r;
);
function zone_swap(a, b) local(i, t, pa, pb)
(
  pa = ZT + a * ZF; pb = ZT + b * ZF;
  i = 0; loop(ZF, t = pa[i]; pa[i] = pb[i]; pb[i] = t; i += 1; );
  strcpy(#_zs, ZSTR + a); strcpy(ZSTR + a, ZSTR + b); strcpy(ZSTR + b, #_zs);
);
// ordena por raiz (y por velocidad) y reparte el teclado: cada zona llega hasta la mitad del camino a la siguiente
// raiz (como un RS5k por zona: 36, 39, 42 -> 0-37, 38-40, 41-43); la primera baja hasta 0 y la ultima sube hasta 127.
// Las zonas con la misma raiz (capas de velocidad) comparten el rango.
function zones_autorange() local(i, j, z, lo, r, hi)
(
  i = 1; loop(ZN - 1, j = i;
    while (j > 0 && ((ZT + (j - 1) * ZF)[2] > (ZT + j * ZF)[2] || ((ZT + (j - 1) * ZF)[2] == (ZT + j * ZF)[2] && (ZT + (j - 1) * ZF)[5] > (ZT + j * ZF)[5]))) ( zone_swap(j - 1, j); j -= 1; );
    i += 1; );
  lo = 0; i = 0;
  while (i < ZN) (
    r = (ZT + i * ZF)[2]; j = i; while (j < ZN && (ZT + j * ZF)[2] == r) ( j += 1; );
    hi = j >= ZN ? 127 : floor((r + (ZT + j * ZF)[2]) / 2);
    while (i < j) ( z = ZT + i * ZF; z[3] = lo; z[4] = hi; i += 1; );
    lo = hi + 1;
  );
);
// despues de cargar zonas: SMP queda con todas, una tras otra
function zones_done()
(
  ZN > 0 ? (
    SN = zone_end() + PADZ; SNCH = ZT[8]; SSR = ZT[7]; SLONG = ZCUT > 0;
    after_load(); ZSEL = clamp(ZSEL, 0, ZN - 1);
  ) : ( LOADING = 0; );
  slider164 = ZN;
);
function zones_clear() ( ZN = 0; ZCUT = 0; ZSKIP = 0; ZSEL = 0; );
// carpeta del sample actual: busca los archivos con el mismo nombre y otra nota (ep_036 ... ep_084, o Rhodes C3 ... Rhodes C5)
function is_blk(n) local(k) ( k = n % 12; k == 1 || k == 3 || k == 6 || k == 8 || k == 10; );
// nombre de nota: fl = 0 con sostenido (C#4), 1 con bemol (Db4)
function note_name_s(d, n, fl) local(k)
(
  k = n % 12;
  strcpy(d, k == 0 ? "C" : k == 1 ? (fl ? "Db" : "C#") : k == 2 ? "D" : k == 3 ? (fl ? "Eb" : "D#") : k == 4 ? "E" : k == 5 ? "F" :
            k == 6 ? (fl ? "Gb" : "F#") : k == 7 ? "G" : k == 8 ? (fl ? "Ab" : "G#") : k == 9 ? "A" : k == 10 ? (fl ? "Bb" : "A#") : "B");
  sprintf(#_o, "%d", floor(n / 12) - 1); strcat(d, #_o);
);
function zones_from_folder(src) local(nn, n, k, kind, w, ok, cnt, try)
(
  nn = name_note(src); cnt = 0;
  nn >= 0 ? (
    kind = NM_KIND; w = NM_W;
    strcpy_substr(#_zpre, src, 0, NM_A); strcpy_substr(#_zsuf, src, NM_B, strlen(src) - NM_B);
    zones_clear(); LOADED = 0;
    n = 0;
    loop(128,
      try = kind == 1 ? 1 : (is_blk(n) ? 2 : 1);
      k = 0;
      while (k < try) (
        strcpy(#_zp, #_zpre);
        kind == 1 ? sprintf(#_zn, w >= 3 ? "%03d" : w == 2 ? "%02d" : "%d", n) : note_name_s(#_zn, n, k);
        strcat(#_zp, #_zn); strcat(#_zp, #_zsuf);
        ok = zone_add(#_zp);
        ok == 1 ? ( (ZT + (ZN - 1) * ZF)[2] = n; (ZT + (ZN - 1) * ZF)[9] = 0; cnt += 1; k = try; ) : ok < 0 ? ( ZSKIP += 1; k = try; );
        k += 1;
      );
      n += 1;
    );
    zones_autorange(); zones_done();
  );
  cnt;
);

// ---------------------------------------------------------------- audio guardado en el proyecto
// Si todo el audio es de 16 bits (valores exactos k / 32768) se guarda empaquetado sin perdida: 3 muestras de 16 bits
// en 2 numeros de 24 bits (los float32 del proyecto los guardan exactos) = 2/3 del tamano.
function ser_write_audio() local(n, i, j, k, m, u0, u1, u2, pk)
(
  pk = S16; file_var(0, pk);
  pk ? (
    n = ceil(SN * 2 / 3); i = 0;
    while (i < n) (
      m = min(floor(TMPN / 2), n - i); k = 0; j = 3 * i;
      loop(m,
        u0 = j < SN * 2 ? SMP[j] * 32768 + 32768 : 32768; u1 = j + 1 < SN * 2 ? SMP[j + 1] * 32768 + 32768 : 32768;
        u2 = j + 2 < SN * 2 ? SMP[j + 2] * 32768 + 32768 : 32768;
        TMP[k] = u0 + 65536 * (u1 & 255); TMP[k + 1] = (u1 >> 8) + 256 * u2;
        k += 2; j += 3; );
      file_mem(0, TMP, 2 * m); i += m;
    );
  ) : file_mem(0, SMP, SN * 2);
);
function ser_read_audio(nf) local(pk, n, i, j, k, m, a, b, tot)
(
  pk = 0; file_var(0, pk);
  pk ? (
    n = ceil(nf * 2 / 3); i = 0; tot = nf * 2;
    while (i < n) (
      m = min(floor(TMPN / 2), n - i); file_mem(0, TMP, 2 * m); k = 0; j = 3 * i;
      loop(m,
        a = TMP[k]; b = TMP[k + 1];
        j < tot ? SMP[j] = ((a & 65535) - 32768) / 32768;
        j + 1 < tot ? SMP[j + 1] = (((a >> 16) | ((b & 255) << 8)) - 32768) / 32768;
        j + 2 < tot ? SMP[j + 2] = ((b >> 8) - 32768) / 32768;
        k += 2; j += 3; );
      i += m;
    );
  ) : file_mem(0, SMP, nf * 2);
);
// al reabrir sin el audio guardado: vuelve a leer cada archivo de las zonas (copia la tabla, la vacia y la rearma)
function zones_reload(n) local(i, z, b, ok)
(
  i = 0; loop(n * ZF, ZTB[i] = ZT[i]; i += 1; );
  i = 0; loop(n, strcpy(ZSTR + 100 + i, ZSTR + i); i += 1; );
  zones_clear(); LOADED = 0; ZMISS = 0;
  i = 0;
  loop(n,
    b = ZTB + i * ZF;
    ok = zone_add(ZSTR + 100 + i);
    ok == 1 ? ( z = ZT + (ZN - 1) * ZF; z[2] = b[2]; z[3] = b[3]; z[4] = b[4]; z[5] = b[5]; z[6] = b[6]; z[9] = b[9]; z[10] = b[10]; )
            : ( ZMISS += 1; strcpy(#zmiss, ZSTR + 100 + i); );
    i += 1;
  );
  zones_done();
);
// ---------------------------------------------------------------- notas
function vctrl(vb) local(semi, r, oct, fc)
(
  vb[24] < 1 ? vb[24] = min(1, vb[24] + vb[25] * CR);
  semi = vb[22] + (vb[23] - vb[22]) * vb[24];
  vb[45] = semi;
  semi += TONEG + G_PITCH + vb[16] * E2_TONO + (vb[19] >= 0 ? CTN[vb[19]] : 0);
  r = 2 ^ (semi / 12);
  STRETCH && vb[19] != -2 ? ( vb[21] = r * vb[54]; vb[53] = SPEED * vb[54]; ) : vb[21] = r * vb[54] * (vb[19] == -2 ? 1 : SPEED);
  FT < 4 ? (
    oct = vb[16] * E2_CUT + KT * (vb[1] - 60) / 12 + vb[37] + G_CUT;
    fc = clamp(CUT * 2 ^ oct, 10, min(20000, srate * 0.48));
    vb[46] = fc; vb[36] = tan($pi * fc / srate);
  );
  vb[51] = vb[10] ? vb[9] - 1 - vb[5] : vb[8] + vb[5];
);
function vkill(vb) ( (vb[0] && !vb[38]) ? vb[38] = KILLN; );
// relajacion lineal (como RS5k): baja en linea recta desde donde esta hasta 0 en el tiempo de relajacion
function vrel(vb) ( vb[3] = 0; vb[18] = 0; vb[15] = 4; vb[17] = 4; vb[57] = vb[14] / max(1, slider36 * srate / 1000); );

// zona: la global VZONE (>= 0) antes de llamar; se vuelve a -1. Inicio / fin / loop (%) son de cada zona.
function start_voice(vb, n, vel, idx, from) local(rv, b0, b1, ul, lm, ls, le, t, i, z, zs, zl, rt, vsr, zls, zle)
(
  rv = REVG; rt = ROOT; vsr = SRR; zls = LPS; zle = LPE;
  idx >= 0 ? ( b0 = CHP[idx]; b1 = PLAYTHRU ? R1 : CHP[idx + 1]; rv = (rv + CRV[idx]) == 1; ) :
  idx == -2 ? ( b0 = PREV_POS; b1 = SN; rv = 0; ) :
  VZONE >= 0 ? (
    z = ZT + VZONE * ZF; zs = z[0]; zl = z[1];
    b0 = zs + floor(clamp(slider5, 0, 100) / 100 * zl); b1 = zs + floor(clamp(slider6, 0, 100) / 100 * zl);
