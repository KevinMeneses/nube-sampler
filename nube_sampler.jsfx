sinc_init();
ptable_init();
SN = 0; LOADED = 0; LAST_SL = -1; MV = -1; LASTN = -1; LASTV = V0; SEL = 0; KBO = 36; CUR_PRESET = 0;
update_params();

@slider
slider159 > 0 ? ( a_pn = floor(slider159 + 0.5); slider159 = 0; slider_automate(slider159); load_preset(a_pn); );
slider1 != LAST_SL ? ( load_slider() ? MISSING = 0; );
// accion por script: zonas con la carpeta del sample del selector
slider166 > 0 ? ( slider166 = 0; slider_automate(slider166); strcpy_fromslider(#a_zp, slider1); zones_from_folder(#a_zp); zones_loaded(); );
update_params();
VMODE != last_vmode || slider2 != last_mode ? ( all_release(); last_vmode = VMODE; last_mode = slider2; MV = -1; );

@serialize
// v1 (Nube Sampler 1.0): ruta, cortes a mano, audio (float). v2 (1.1): + zonas; audio sin limite de largo, empaquetado si es de 16 bits.
a_wr = file_avail(0) < 0;
a_wr ? (
  a_ver = 2; file_var(0, a_ver); file_var(0, SRC_KIND); file_var(0, LAST_SL); file_string(0, #spath);
  file_var(0, NMAN); a_i = 0; loop(NMAN, file_var(0, MANP[a_i]); a_i += 1; );
  file_var(0, ZN); a_i = 0; loop(ZN, a_j = 0; loop(ZF, file_var(0, ZT[a_i * ZF + a_j]); a_j += 1; ); file_string(0, ZSTR + a_i); a_i += 1; );
  a_emb = slider62 && LOADED; file_var(0, a_emb);
  a_emb ? ( file_var(0, SN); file_var(0, SNCH); file_var(0, SSR); ser_write_audio(); );
) : (
  a_ver = 0; file_var(0, a_ver);
  a_ver >= 1 ? (
    file_var(0, a_kind); file_var(0, a_sl); file_string(0, #a_path);
    file_var(0, NMAN); NMAN = clamp(NMAN, 0, MAXCH); a_i = 0; loop(NMAN, file_var(0, MANP[a_i]); a_i += 1; ); MANVER += 1;
    a_zn = 0;
    a_ver >= 2 ? ( file_var(0, a_zn); a_zn = clamp(a_zn, 0, MAXZ);
      a_i = 0; loop(a_zn, a_j = 0; loop(ZF, file_var(0, ZT[a_i * ZF + a_j]); a_j += 1; ); file_string(0, ZSTR + a_i); a_i += 1; ); );
    a_emb = 0; file_var(0, a_emb);
    a_emb ? (
      a_n = 0; file_var(0, a_n); file_var(0, a_ch); file_var(0, a_sr);
      (a_n > 1 && a_n <= MAXF) ? (
        LOADING = 1; all_kill_now();
        a_ver >= 2 ? ser_read_audio(a_n) : file_mem(0, SMP, a_n * 2);
        SN = a_n; SNCH = a_ch; SSR = a_sr; ZN = a_zn; slider164 = ZN; ZMISS = 0;
        after_load(); MISSING = 0; LIBMISS = 0; SRC_KIND = a_kind; strcpy(#spath, #a_path); set_name(#spath);
        ZN > 0 ? zone_name();
      ) : a_emb = 0;
    );
    !a_emb ? (
      a_zn > 0 ? zones_reload(a_zn) :
      a_kind == 2 ? ( a_ok = load_path(#a_path); !a_ok ? ( all_kill_now(); LOADED = 0; SN = 0; slider161 = 0; MISSING = 1; SRC_KIND = 2;
        strcpy(#spath, #a_path); set_name(#spath); LAST_SIG = -1; update_params(); ); );
    );
    LAST_SL = slider1;
  );
);

@block
upd ? ( upd = 0; update_params(); );
tempo != last_tempo ? ( update_speed(); slider52 > 0 ? LFRATE = max(tempo, 20) / 60 / fig_beats(slider52); );
(play_state & 1) && slider52 > 0 && !LFRT ? ( a_bb = fig_beats(slider52); lph = beat_position / a_bb - floor(beat_position / a_bb); );
qn = 0; qi = 0; scnt = 0;
// eventos de la interfaz (teclado en pantalla, pads, escucha desde la forma de onda)
while (kqr != kqw) (
  a_t = KQT[kqr];
  a_t == 2 ? preview_on(KQP[kqr]) : a_t == 3 ? preview_off() : (
    Q[qn * 4] = 0; Q[qn * 4 + 1] = KQV[kqr] > 0 ? 0x90 : 0x80; Q[qn * 4 + 2] = KQN[kqr]; Q[qn * 4 + 3] = KQV[kqr]; qn += 1;
  );
  kqr = (kqr + 1) % 64;
);
while (midirecv(a_ofs, a_m1, a_m2, a_m3)) (
  qn < QMAX ? ( Q[qn * 4] = a_ofs; Q[qn * 4 + 1] = a_m1; Q[qn * 4 + 2] = a_m2; Q[qn * 4 + 3] = a_m3; qn += 1; );
);
a_n = 0; a_v = 0; a_i = 0; loop(MAXCH, CHPLAY[a_i] = 0; a_i += 1; );
loop(MAXV, a_vb = V0 + a_v * VS; a_vb[0] ? ( a_n += 1; a_vb[19] >= 0 ? CHPLAY[a_vb[19]] = 1; ); a_v += 1; );
slider160 = a_n;

@sample
while (qi < qn && Q[qi * 4] <= scnt) ( midi_ev(Q[qi * 4 + 1], Q[qi * 4 + 2], Q[qi * 4 + 3]); qi += 1; );
scnt += 1;
(crc -= 1) <= 0 ? ( crc = CR; ctrl_all(); );

OUTL = OUTR = 0;
!LOADING ? ( a_v = 0; loop(MAXV, a_vb = V0 + a_v * VS; a_vb[0] ? vtick(a_vb); a_v += 1; ); );
a_l = OUTL * NORMG; a_r = OUTR * NORMG;
LVOL ? ( a_l *= G_VOL; a_r *= G_VOL; );
WIDTH != 1 ? ( a_mid = (a_l + a_r) * 0.5; a_sd = (a_l - a_r) * 0.5 * WIDTH; a_l = a_mid + a_sd; a_r = a_mid - a_sd; );
a_p = clamp(PANB + G_PAN, -1, 1);
a_p != 0 ? ( a_l *= min(1, 1 - a_p); a_r *= min(1, 1 + a_p); );
// lo-fi: baja la frecuencia de muestreo (retencion) y los bits
LFI_SR ? ( lfph += LSR / srate; lfph >= 1 ? ( lfph -= 1; lfh_l = a_l; lfh_r = a_r; ); a_l = lfh_l; a_r = lfh_r; );
BITS < 24 ? ( a_qq = 2 ^ (BITS - 1); a_l = floor(a_l * a_qq + 0.5) / a_qq; a_r = floor(a_r * a_qq + 0.5) / a_qq; );
spl0 = a_l * VOLG; spl1 = a_r * VOLG;
abs(spl0) > m_l ? m_l = abs(spl0); abs(spl1) > m_r ? m_r = abs(spl1);

@gfx 1100 800
// ======================================================================= interfaz
SC = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
WW = gfx_w; WH = gfx_h;

function fnt(i) (
  i == 1 ? gfx_setfont(1, "Helvetica Neue", 13 * SC) :
  i == 2 ? gfx_setfont(2, "Helvetica Neue", 11 * SC) :
  i == 3 ? gfx_setfont(3, "Helvetica Neue", 17 * SC, 'b') :
  i == 4 ? gfx_setfont(4, "Helvetica Neue", 10 * SC, 'b') :
  i == 6 ? gfx_setfont(6, "Helvetica Neue", 15 * SC, 'b') :
  i == 7 ? gfx_setfont(7, "Helvetica Neue", 10 * SC) :
  i == 8 ? gfx_setfont(8, "Helvetica Neue", 18 * SC) :
           gfx_setfont(5, "Helvetica Neue", 12 * SC, 'b');
);
function setcol(c) (
  c == 0 ? ( KR = 0.42; KG = 0.78; KB = 1.00; ) : c == 1 ? ( KR = 0.45; KG = 0.90; KB = 0.95; ) :
  c == 2 ? ( KR = 0.50; KG = 0.92; KB = 0.70; ) : c == 3 ? ( KR = 1.00; KG = 0.70; KB = 0.36; ) :
  c == 4 ? ( KR = 0.55; KG = 0.90; KB = 0.50; ) : c == 5 ? ( KR = 0.93; KG = 0.86; KB = 0.40; ) :
  c == 6 ? ( KR = 0.78; KG = 0.60; KB = 1.00; ) : c == 7 ? ( KR = 1.00; KG = 0.55; KB = 0.78; ) :
  c == 8 ? ( KR = 0.95; KG = 0.45; KB = 0.60; ) : c == 9 ? ( KR = 0.97; KG = 0.50; KB = 0.42; ) :
           ( KR = 0.80; KG = 0.82; KB = 0.88; );
);
function acc(a) ( gfx_set(KR, KG, KB, a); );
function hit_add(x, y, w, h, id) local(p)
( hit_n < 200 ? ( p = hitmem + hit_n * 5; p[0] = x; p[1] = y; p[2] = w; p[3] = h; p[4] = id; hit_n += 1; ); );
function hit_find(mx, my) local(i, p, r)
(
  r = 0; i = hit_n - 1;
  while (i >= 0 && r == 0) (
    p = hitmem + i * 5;
    (mx >= p[0] && mx < p[0] + p[2] && my >= p[1] && my < p[1] + p[3]) ? r = p[4];
    i -= 1;
  );
  r;
);
function frect(x, y, w, h, r) (
  r = min(r, min(w, h) * 0.5);
  gfx_rect(x + r, y, w - 2 * r, h, 1);
  gfx_rect(x, y + r, r, h - 2 * r, 1);
  gfx_rect(x + w - r, y + r, r, h - 2 * r, 1);
  gfx_circle(x + r, y + r, r, 1, 1); gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1); gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);
function text_c(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 1 | 4, x + w, y + h); );
function text_l(str, x, y, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 4, x + 2000, y + h); );
function text_r(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 2 | 4, x + w, y + h); );
function fmt_f(d, f) ( f < 1000 ? sprintf(d, "%d Hz", floor(f + 0.5)) : sprintf(d, f < 10000 ? "%.2f kHz" : "%.1f kHz", f / 1000); );
function fmt_ms(d, t) ( t < 10 ? sprintf(d, "%.1f ms", t) : t < 1000 ? sprintf(d, "%d ms", floor(t + 0.5)) : sprintf(d, "%.2f s", t / 1000); );
function note_str(d, n) local(k)
(
  k = n % 12;
  strcpy(d, k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" : k == 6 ? "F#" :
            k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B");
  sprintf(#_o, "%d", floor(n / 12) - 1); strcat(d, #_o);
);
function button(id, x, y, w, h, str, on)
(
  hov = hover_id == id;
  on ? acc(1) : gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 4 * SC);
  on ? gfx_set(0.07, 0.08, 0.10, 1) : gfx_set(0.86, 0.88, 0.92, 1);
  fnt(h < 20 * SC ? 7 : 1); text_c(str, x, y, w, h);
  hit_add(x, y, w, h, id);
);
function dropdown(id, x, y, w, h, label, str)
(
  hov = hover_id == id;
  gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  fnt(h < 20 * SC ? 7 : 2); gfx_set(0.55, 0.58, 0.65, 1);
  text_l(label, x + 8 * SC, y, h);
  strlen(label) ? gfx_measurestr(label, _tw, _th) : _tw = -4 * SC;
  fnt(h < 20 * SC ? 7 : 1); gfx_set(0.90, 0.92, 0.96, 1);
  text_l(str, x + 12 * SC + _tw, y, h);
  gfx_set(0.55, 0.58, 0.65, 1);
  _cx = x + w - 10 * SC; _cy = y + h * 0.5;
  gfx_triangle(_cx - 3 * SC, _cy - 2 * SC, _cx + 3 * SC, _cy - 2 * SC, _cx, _cy + 2 * SC);
  hov ? ( dd_x = x; dd_y = y + h + 2 * SC; );    // el menu se abre debajo del control
  hit_add(x, y, w, h, id);
);
function knob(id, cx, cy, r, label, str, n, bip, enabled) local(a0, a1, av, i, rad)
(
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; av = a0 + (a1 - a0) * clamp(n, 0, 1);
  fnt(7); gfx_set(0.62, 0.65, 0.72, enabled ? 1 : 0.4);
  text_c(label, cx - 30 * SC, cy - r - 15 * SC, 60 * SC, 13 * SC);
  gfx_set(0.13, 0.14, 0.18, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.26, 0.28, 0.34, 1);
  i = 0; loop(3 * SC, gfx_arc(cx, cy, r - 2 * SC - i, a0, a1, 1); i += 1; );
  acc(enabled ? 1 : 0.35);
  i = 0; loop(3 * SC, rad = r - 2 * SC - i;
    bip ? ( av < 0 ? gfx_arc(cx, cy, rad, av, 0, 1) : gfx_arc(cx, cy, rad, 0, av, 1); )
        : gfx_arc(cx, cy, rad, a0, av, 1);
    i += 1; );
  gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.4);
  gfx_line(cx + sin(av) * r * 0.25, cy - cos(av) * r * 0.25, cx + sin(av) * (r - 5 * SC), cy - cos(av) * (r - 5 * SC), 1);
  hover_id == id ? ( gfx_set(1, 1, 1, 0.12); gfx_circle(cx, cy, r + 2 * SC, 0, 1); );
  fnt(2); gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.45);
  text_c(str, cx - 30 * SC, cy + r + 2 * SC, 60 * SC, 14 * SC);
  hit_add(cx - r - 6 * SC, cy - r - 14 * SC, 2 * r + 12 * SC, 2 * r + 30 * SC, id);
);

// ---------------------------------------------------------- perillas: id = numero de slider
// la velocidad del LFO a tempo recorre las figuras (slider 52)
function ksl(id) ( (id == 51 && slider52) ? 52 : id; );
function ctl_get(id) local(s, v, a, b)
(
  s = ksl(id); v = slider(s); a = PMIN[s]; b = PMAX[s];
  s == 52 ? (v - 1) / 15 :
  PCUR[s] == 1 ? nlog(v, a, b) : PCUR[s] == 2 ? sqrt((v - a) / (b - a)) : PCUR[s] == 3 ? ((v - a) / (b - a)) ^ (1 / 3) : (v - a) / (b - a);
);
function ctl_setv(s, v)
(
  v = clamp(floor(v / PSTEP[s] + 0.5) * PSTEP[s], PMIN[s], PMAX[s]);
  sset(s, v); upd = 1;
);
function ctl_set(id, n) local(s, a, b)
(
  n = clamp(n, 0, 1); s = ksl(id); a = PMIN[s]; b = PMAX[s];
  s == 52 ? ( sset(s, 1 + floor(n * 15 + 0.5)); upd = 1; ) :
  ctl_setv(s, PCUR[s] == 1 ? dlog(n, a, b) : PCUR[s] == 2 ? a + (b - a) * n * n : PCUR[s] == 3 ? a + (b - a) * n * n * n : a + (b - a) * n);
);
function ctl_default(id) local(s) ( s = ksl(id); s == 52 ? sset(s, 9) : ctl_setv(s, PDEF[s]); upd = 1; );

function val_str(s) local(v, u)
(
  v = slider(s); u = PUNIT[s];
  s == 29 ? sprintf(#v, "%d voces", v) :
  s == 30 ? ( v < 0.5 ? strcpy(#v, "Apagado") : fmt_ms(#v, v); ) :
  s == 31 ? sprintf(#v, "+/- %d st", v) :
  s == 18 && SYNCN > 0 ? sprintf(#v, "%.1f %%", SPEED * 100) :
  (s == 51 && slider52) ? strcpy(#v, fig_name(slider52)) :
  s == 56 ? ( v >= 24 ? strcpy(#v, "Apagado") : sprintf(#v, "%d bits", v); ) :
  s == 57 ? ( LFI_SR ? fmt_f(#v, v) : strcpy(#v, "Apagado"); ) :
  s == 11 && v < 0.05 ? strcpy(#v, "Apagado") :
  (s == 12 || s == 13) && v < 0.05 ? strcpy(#v, "0 ms") :
  u == 9 ? note_str(#v, v) :
  u == 1 ? ( PMIN[s] < 0 ? ( abs(v) < 0.05 ? strcpy(#v, "0 %") : sprintf(#v, "%+.0f %%", v); ) : sprintf(#v, PSTEP[s] < 0.01 ? "%.1f %%" : "%.0f %%", v); ) :
  u == 2 ? ( s == 39 ? fmt_f(#v, v) : sprintf(#v, v < 10 ? "%.2f Hz" : "%.1f Hz", v); ) :
  u == 3 ? fmt_ms(#v, v) :
  u == 4 ? ( abs(v) < 0.05 ? strcpy(#v, "0 st") : sprintf(#v, PSTEP[s] < 1 ? "%+.1f st" : "%+d st", v); ) :
  u == 5 ? ( abs(v) < 0.05 ? strcpy(#v, "0 c") : sprintf(#v, "%+.0f c", v); ) :
  u == 6 ? ( abs(v) < 0.05 ? strcpy(#v, "0.0 dB") : sprintf(#v, "%+.1f dB", v); ) :
  u == 7 ? sprintf(#v, "%.1f s", v) :
  sprintf(#v, "%d", v);
  #v;
);
function pknob(s, cx, cy, r, label, enabled) ( knob(s, cx, cy, r, label, val_str(s), ctl_get(s), PMIN[ksl(s)] < 0, enabled); );

function ft_name(t) ( t == 0 ? "LP 24" : t == 1 ? "LP 12" : t == 2 ? "BP" : t == 3 ? "HP 12" : "Off"; );
function vmode_name(m) ( m == 0 ? "Poly" : m == 1 ? "Mono" : "Legato"; );
function dest_name(d) ( d == 0 ? "Tono" : d == 1 ? "Corte" : d == 2 ? "Volumen" : "Paneo"; );
function lfo_name(w) ( w == 0 ? "Sen" : w == 1 ? "Tri" : w == 2 ? "Sie" : w == 3 ? "Cua" : "Ale"; );

// ---------------------------------------------------------- ayudas
function hint_for(id)
(
  id == 5 ? strcpy(#hint, "Inicio: desde donde suena el sample. Tambien se arrastra la bandera S en la forma de onda.") :
  id == 6 ? strcpy(#hint, "Fin: hasta donde suena. Tambien se arrastra la bandera E en la forma de onda.") :
  id == 9 || id == 10 ? strcpy(#hint, "Puntos del loop (banderas L abajo de la forma de onda). Solo en Clasico con Disparo = Mantener.") :
  id == 11 ? strcpy(#hint, "Crossfade del loop: funde el final con lo que hay antes del inicio para que el salto no haga clic.") :
  id == 12 ? strcpy(#hint, "Fade in: sube el volumen al empezar cada nota o chop (quita el clic de un corte a mitad de onda).") :
  id == 13 ? strcpy(#hint, "Fade out: baja el volumen antes del final de la region o del chop.") :
  id == 14 ? strcpy(#hint, "Nota raiz: la nota en la que el sample suena tal cual. Usa Afinar para ponerla sola.") :
  id == 16 ? strcpy(#hint, "Tono en semitonos (todo el sample o todos los chops).") :
  id == 17 ? strcpy(#hint, "Fino en cents. Afinar lo ajusta para que el sample quede en 440 Hz.") :
  id == 18 ? strcpy(#hint, "Velocidad de reproduccion. En Remuestreo cambia tono y tiempo (vinilo); en Estirar solo el tiempo.") :
  id == 20 ? strcpy(#hint, "Grano del estirado: corto (20-40 ms) para ritmos y voces, largo (80-200 ms) para pads y texturas.") :
  id == 23 ? strcpy(#hint, "Sensibilidad de los transitorios: mas alta = corta en golpes mas suaves.") :
  id == 24 ? strcpy(#hint, "Partes iguales: en cuantos trozos se divide la region.") :
  id == 25 ? strcpy(#hint, "Nota del primer chop; los siguientes van en las teclas de arriba (36 = C2, los pads de una MPC).") :
  id == CHOP0 + 3 * SEL ? strcpy(#hint, "Tono del chop seleccionado (semitonos).") :
  id == CHOP0 + 3 * SEL + 1 ? strcpy(#hint, "Ganancia del chop seleccionado.") :
  id == 29 ? strcpy(#hint, "Voces: cuantas notas pueden sonar a la vez. Si tocas mas, se apaga la mas vieja en 3 ms.") :
  id == 30 ? strcpy(#hint, "Glide: la nota se desliza desde la anterior. En Legato solo si las notas se pisan (808 con slides).") :
  id == 31 ? strcpy(#hint, "Pitch bend: cuantos semitonos mueve la rueda de tono.") :
  id == 32 ? strcpy(#hint, "Vibrato de la rueda de modulacion (CC1), en cents.") :
  id == 33 ? strcpy(#hint, "Ataque: 0 = el sample entra tal cual. Largo = entra suave.") :
  id == 34 ? strcpy(#hint, "Decaimiento: cuanto tarda en bajar al sostenido.") :
  id == 35 ? strcpy(#hint, "Sostenido: nivel mientras mantienes la tecla. 0 % = se apaga solo despues del decaimiento.") :
  id == 36 ? strcpy(#hint, "Relajacion: cuanto sigue sonando al soltar la tecla (en Disparo Mantener).") :
  id == 37 ? strcpy(#hint, "Velocidad a volumen: cuanto cambia el volumen con la fuerza del golpe.") :
  id == 39 ? strcpy(#hint, "Corte del filtro.") :
  id == 40 ? strcpy(#hint, "Resonancia: realza el corte.") :
  id == 41 ? strcpy(#hint, "Drive: satura antes del filtro (tambien con el filtro en Off).") :
  id == 42 ? strcpy(#hint, "Env 2 a corte: la envolvente 2 abre o cierra el filtro.") :
  id >= 43 && id <= 46 ? strcpy(#hint, "Envolvente 2 (filtro y tono): ataque, decaimiento, sostenido, relajacion.") :
  id == 47 ? strcpy(#hint, "Env 2 a tono: la nota empieza mas aguda o grave y vuelve (golpe del 808).") :
  id == 48 ? strcpy(#hint, "Seguimiento de teclado: las notas agudas abren el filtro.") :
  id == 49 ? strcpy(#hint, "Velocidad a corte: tocar suave oscurece el sonido.") :
  id == 51 ? strcpy(#hint, "Velocidad del LFO (Hz), o la figura si esta A tempo.") :
  id == 54 ? strcpy(#hint, "Cantidad del LFO (100 % en Tono = +/- 12 st; en Corte = +/- 4 octavas).") :
  id == 56 ? strcpy(#hint, "Bits: menos bits = mas ruido y aspereza (12 = SP-1200 / MPC60).") :
  id == 57 ? strcpy(#hint, "Muestreo: baja la frecuencia de muestreo (26 kHz = SP-1200). Agrega espejos agudos metalicos.") :
  id == 58 ? strcpy(#hint, "Paneo (balance) de la salida.") :
  id == 59 ? strcpy(#hint, "Ancho estereo: 0 % = mono, 100 % = como el sample, 200 % = mas abierto.") :
  id == 60 ? strcpy(#hint, "Volumen de salida.") :
  id == 300 ? strcpy(#hint, "Presets: instrumento, 808, pads, one-shots, chops (MPC), loops a tempo, lo-fi. No cambian el sample.") :
  id == 301 ? strcpy(#hint, "Voces: Poly, Mono (glide siempre) o Legato (glide si las notas se pisan, sin reatacar).") :
  id == 700 ? strcpy(#hint, CHOPS ? "Clic = escuchar el chop. Doble clic = agregar corte (pasa a A mano). Clic derecho en un corte = quitarlo. Rueda = zoom." :
                                     "Mantener clic = escuchar desde ahi. Arrastra S / E (inicio y fin) y L (loop). Rueda = zoom, shift + rueda = mover.") :
  id == 705 ? strcpy(#hint, "Vista completa: clic o arrastrar para mover el zoom. Doble clic = ver todo.") :
  id >= 701 && id <= 704 ? strcpy(#hint, "Arrastra para mover el punto (shift = fino). Doble clic = volver al valor por defecto.") :
  id >= 1000 && id < 1100 ? strcpy(#hint, "Corte: arrastra para moverlo (pasa a A mano). Clic derecho = quitarlo.") :
  id >= 800 && id < 832 ? strcpy(#hint, "Pad: clic = escuchar y seleccionar el chop (sus ajustes van a la derecha).") :
  id == 840 ? strcpy(#hint, "Cambia entre los pads 1-16 y 17-32.") :
  id == 852 ? strcpy(#hint, "El sample se elige en el selector Sample de arriba (REAPER/Data/Nube Sampler) o arrastrando un archivo a la ventana.") :
  id == 853 ? strcpy(#hint, "Reverso: todo el sample suena al reves.") :
  id == 854 ? strcpy(#hint, "Normalizar: sube el sample para que su pico llegue a 0 dB.") :
  id == 855 ? strcpy(#hint, "Afinar: pone la nota raiz y el fino segun la nota detectada, para que el sample quede afinado.") :
  id == 857 ? strcpy(#hint, "Sigue teclado: cada tecla cambia el tono. Tono fijo: todas las teclas suenan igual (loops, baterias).") :
  id == 856 ? strcpy(#hint, "Guardar el audio dentro del proyecto (hasta ~40 s): el proyecto suena aunque muevas o borres el archivo.") :
  id == 860 || id == 861 ? strcpy(#hint, "Clasico: el sample entero en el teclado. Chops: cada trozo en una tecla (como una MPC).") :
  id == 862 || id == 863 ? strcpy(#hint, "Mantener: suena mientras tienes la tecla. One-shot: suena hasta el final aunque sueltes (baterias).") :
  id == 864 || id == 865 ? strcpy(#hint, "Remuestreo: tono y tiempo juntos (vinilo). Estirar: tono y tiempo independientes (loops a tempo).") :
  id >= 870 && id <= 872 ? strcpy(#hint, "Loop: Apagado, Adelante (con crossfade) o Ping-pong (ida y vuelta).") :
  id == 873 || id == 874 ? strcpy(#hint, "Calidad: Normal (Hermite, liviana) o Alta (sinc con anti-aliasing al subir el tono).") :
  id == 875 ? strcpy(#hint, "A tempo: la region dura lo que elijas al BPM del proyecto. Con Estirar no cambia el tono.") :
  id >= 880 && id <= 882 ? strcpy(#hint, "Como se corta: por Transitorios (golpes), en Partes iguales, o A mano (doble clic en la onda).") :
  id == 883 ? strcpy(#hint, "Cada chop suena hasta su final, o sigue hasta el final del sample.") :
  id == 884 ? strcpy(#hint, "Choke: un chop corta al anterior (como los grupos de corte de una MPC).") :
  id == 885 ? strcpy(#hint, "Reverso del chop seleccionado.") :
  (id >= 230 && id <= 234) ? strcpy(#hint, "Tipo de filtro: LP 24, LP 12, BP, HP 12 u Off.") :
  (id >= 240 && id <= 244) ? strcpy(#hint, "Forma del LFO: Seno, Triangulo, Sierra, Cuadrada o Aleatorio.") :
  id == 260 ? strcpy(#hint, "Destino del LFO: Tono (vibrato), Corte (wah), Volumen (tremolo) o Paneo.") :
  id == 262 ? strcpy(#hint, "A tempo: el LFO sigue el BPM y se alinea con la cancion.") :
  id == 264 ? strcpy(#hint, "Nota: el LFO empieza de cero con cada nota.") :
  id == 403 ? strcpy(#hint, "Medidor de salida. Clic = reiniciar el maximo.") :
  (id == 600 || id == 601) ? strcpy(#hint, "Cambia la octava del teclado en pantalla.") :
  id >= 500 && id < 600 ? strcpy(#hint, "Teclado: clic para tocar (mas abajo en la tecla = mas fuerte). En Chops las teclas de color tienen chop.") :
  strcpy(#hint, "Nube Sampler: elige un sample (selector Sample de arriba, o arrastralo a la ventana), un preset, y toca. Pasa el mouse sobre algo para ver que hace.");
);

// ---------------------------------------------------------- sample
// La interfaz no puede cambiar el slider de archivo (REAPER no lo acepta desde @gfx): la biblioteca se elige con el
// selector "Sample" de REAPER (arriba) o arrastrando un archivo. Este menu lo explica.
function menu_sample() local(r)
(
  #m = "#ELEGIR SAMPLE||#Biblioteca: el selector Sample, arriba de esta ventana|#(carpeta REAPER/Data/Nube Sampler, con subcarpetas)||#O arrastra un archivo de audio a la ventana|#(wav, aif, flac, mp3, ogg)";
  LOADED ? ( strcat(#m, "||#Cargado: "); strcat(#m, #spath); );
  gfx_x = dd_x; gfx_y = dd_y;
  gfx_showmenu(#m);
);
function menu_presets() local(r, i)
(
  #m = "#PRESETS (no cambian el sample)|>Clasico";
  i = 1; loop(4, strcat(#m, i == 4 ? "|<" : "|"); strcat(#m, preset_name(i)); i += 1; );
  strcat(#m, "|>One-shot"); loop(2, strcat(#m, i == 6 ? "|<" : "|"); strcat(#m, preset_name(i)); i += 1; );
  strcat(#m, "|>Chops"); loop(4, strcat(#m, i == 10 ? "|<" : "|"); strcat(#m, preset_name(i)); i += 1; );
  strcat(#m, "|>Loops"); loop(2, strcat(#m, i == 12 ? "|<" : "|"); strcat(#m, preset_name(i)); i += 1; );
  strcat(#m, "|>Lo-fi y FX"); loop(3, strcat(#m, i == 15 ? "|<" : "|"); strcat(#m, preset_name(i)); i += 1; );
  strcat(#m, "|"); strcat(#m, preset_name(16));
  gfx_x = dd_x; gfx_y = dd_y;
  r = gfx_showmenu(#m);
  r >= 2 ? ( load_preset(r - 1); update_params(); );
);
function menu_list(kind, n, cur) local(r, i)
(
  #m = ""; i = 0;
  loop(n, i ? strcat(#m, "|"); i == cur ? strcat(#m, "!");
    strcat(#m, kind == 1 ? vmode_name(i) : kind == 2 ? dest_name(i) : sync_name(i)); i += 1; );
  gfx_x = dd_x; gfx_y = dd_y;
  gfx_showmenu(#m);
);

// eventos para @block
function kq(t, n, v, p) ( KQT[kqw] = t; KQN[kqw] = n; KQV[kqw] = v; KQP[kqw] = p; kqw = (kqw + 1) % 64; );
function is_black(n) local(k) ( k = n % 12; k == 1 || k == 3 || k == 6 || k == 8 || k == 10; );

// cortes a mano: la lista MANP guarda fracciones del sample, ordenadas
function man_from_current() local(k)
( NMAN = 0; k = 1; loop(NCH - 1, MANP[NMAN] = CHP[k] / SN; NMAN += 1; k += 1; ); sset(22, 2); MANVER += 1; );
function man_sort() local(i, j, t)
( i = 1; loop(NMAN - 1, j = i; while (j > 0 && MANP[j - 1] > MANP[j]) ( t = MANP[j]; MANP[j] = MANP[j - 1]; MANP[j - 1] = t; j -= 1; ); i += 1; ); );
function man_add(f) ( NMAN < MAXCH - 1 ? ( MANP[NMAN] = f; NMAN += 1; man_sort(); MANVER += 1; update_params(); ); );
function man_del(k) local(i) ( (k >= 0 && k < NMAN) ? ( i = k; loop(NMAN - k - 1, MANP[i] = MANP[i + 1]; i += 1; ); NMAN -= 1; MANVER += 1; update_params(); ); );
// indice en MANP del corte que esta en CHP[k]
function man_index(k) local(i, r) ( r = -1; i = 0; loop(NMAN, abs(floor(MANP[i] * SN) - CHP[k]) < 2 ? r = i; i += 1; ); r; );

// ======================================================================= layout
TOPH = 44 * SC; FOOTH = 26 * SC; KBH = 54 * SC; RH = 100 * SC; GAP = 6 * SC; KS = 44 * SC; KRAD = 14 * SC;
kby = WH - FOOTH - 8 * SC - KBH;
r4y = kby - 8 * SC - RH; r3y = r4y - GAP - RH; r2y = r3y - GAP - RH; r1y = r2y - GAP - RH;
sby = TOPH + 8 * SC; SBH = 26 * SC;
WFY = sby + SBH + 6 * SC; WFH = r1y - 8 * SC - WFY; WFH < 90 * SC ? WFH = 90 * SC;
OVH = 14 * SC; MTW = 30 * SC;
WFX = 14 * SC; WFW = WW - 28 * SC - MTW - GAP; WFVH = WFH - OVH - 4 * SC;     // forma de onda (sin la tira de vista completa)
mtx = WFX + WFW + GAP;

// conversiones de la forma de onda
VZ1 <= VZ0 ? ( VZ0 = 0; VZ1 = max(SN, 1); );
function f2x(f) ( WFX + (f - VZ0) / (VZ1 - VZ0) * WFW; );
function x2f(x) ( VZ0 + (x - WFX) / WFW * (VZ1 - VZ0); );
function zoom_at(f, k) local(a, b)
(
  a = f - (f - VZ0) * k; b = f + (VZ1 - f) * k;
  b - a < 64 ? ( a = f - 32; b = f + 32; );
  a < 0 ? ( b -= a; a = 0; ); b > SN ? ( a -= b - SN; b = SN; ); a < 0 ? a = 0;
  VZ0 = a; VZ1 = b;
);
function flag(id, f, str, up, c_r, cg, cb) local(x)
(
  x = f2x(f);
  (x >= WFX - 1 && x <= WFX + WFW + 1) ? (
    gfx_set(c_r, cg, cb, hover_id == id ? 1 : 0.8); gfx_line(x, WFY, x, WFY + WFVH);
    up ? gfx_rect(x - (id == 702 ? 14 * SC : 0), WFY, 14 * SC, 12 * SC, 1) : gfx_rect(x - (id == 704 ? 14 * SC : 0), WFY + WFVH - 12 * SC, 14 * SC, 12 * SC, 1);
    gfx_set(0.07, 0.08, 0.1, 1); fnt(4);
    text_c(str, x - (id == 702 || id == 704 ? 14 * SC : 0), up ? WFY : WFY + WFVH - 12 * SC, 14 * SC, 12 * SC);
    hit_add(x - (id == 702 || id == 704 ? 16 : 2) * SC, up ? WFY : WFY + WFVH - 14 * SC, 18 * SC, 14 * SC, id);
    hit_add(x - 3 * SC, WFY, 6 * SC, WFVH, id);
  );
);
function pan_view(d) local(w) ( w = VZ1 - VZ0; VZ0 = clamp(VZ0 + d, 0, max(0, SN - w)); VZ1 = VZ0 + w; );

// ======================================================================= arrastrar y soltar
gfx_getdropfile(0, #_drop) ? (
  load_path(#_drop) ? ( CUR_MSG = 0; ) : ( CUR_MSG = 1; msg_t = time_precise(); );
  gfx_getdropfile(-1);
);

// ======================================================================= mouse
mx = mouse_x; my = mouse_y;
lb = mouse_cap & 1; rb = mouse_cap & 2; shift = mouse_cap & 8; alt = mouse_cap & 16;
hover_id = drag ? drag_id : hit_find(mx, my);

rb && !last_rb ? (
  hover_id >= 1000 && hover_id < 1100 ? (
    _k = hover_id - 1000; CDET != 2 ? man_from_current(); man_del(man_index(_k));
  );
);
lb && !last_lb ? (
  _now = time_precise();
  dbl = _now - last_t < 0.35 && abs(mx - last_x) < 6 * SC && abs(my - last_y) < 6 * SC;
  last_t = dbl ? 0 : _now; last_x = mx; last_y = my;
  (hover_id >= 2 && hover_id <= NPARAMS) ? (
    dbl ? ctl_default(hover_id) : ( drag = 1; drag_id = hover_id; drag_my = my; drag_n = ctl_get(hover_id); );
  ) :
  hover_id == 700 && LOADED ? (
    _f = clamp(x2f(mx), 0, SN - 1);
    dbl ? ( CHOPS ? ( CDET != 2 ? man_from_current(); man_add(_f / SN); ) : ( VZ0 = 0; VZ1 = SN; ); ) :
    CHOPS ? (
      _k = 0; loop(NCH, (_f >= CHP[_k] && _f < CHP[_k + 1]) ? SEL = _k; _k += 1; );
      (_f >= CHP[0] && _f < CHP[NCH]) ? ( pad_note = CHB + SEL; kq(1, pad_note, 110, 0); drag = 1; drag_id = 800; );
    ) : ( kq(2, 0, 0, _f); drag = 1; drag_id = 799; );
  ) :
  (hover_id >= 701 && hover_id <= 704) ? (
    dbl ? ( sset(hover_id == 701 ? 5 : hover_id == 702 ? 6 : hover_id == 703 ? 9 : 10, hover_id == 701 || hover_id == 703 ? 0 : 100); update_params(); )
        : ( drag = 1; drag_id = hover_id; );
  ) :
  (hover_id >= 1000 && hover_id < 1100) ? (
    alt ? ( _k = hover_id - 1000; CDET != 2 ? man_from_current(); man_del(man_index(_k)); ) : (
      _k = hover_id - 1000; CDET != 2 ? ( man_from_current(); update_params(); );
      drag = 1; drag_id = 1000; drag_man = man_index(_k);
    );
  ) :
  hover_id == 705 ? ( dbl ? ( VZ0 = 0; VZ1 = SN; ) : ( drag = 1; drag_id = 705; ); ) :
  (hover_id >= 800 && hover_id < 832) ? (
    SEL = hover_id - 800;
    SEL < NCH ? ( pad_note = CHB + SEL; kq(1, pad_note, 110, 0); drag = 1; drag_id = 800; );
  ) :
  hover_id == 840 ? PADPAGE = !PADPAGE :
  hover_id == 852 ? menu_sample() :
  hover_id == 853 ? ( sset(7, !slider7); update_params(); ) :
  hover_id == 854 ? ( sset(61, !slider61); update_params(); ) :
  hover_id == 855 ? ( DET_NOTE >= 0 ? ( sset(14, clamp(floor(DET_NOTE + 0.5), 0, 127)); sset(17, clamp(-(DET_NOTE - floor(DET_NOTE + 0.5)) * 100, -100, 100)); update_params(); ); ) :
  hover_id == 856 ? ( sset(62, !slider62); update_params(); ) :
  hover_id == 857 ? ( sset(15, !slider15); update_params(); ) :
  (hover_id >= 860 && hover_id <= 865) ? (
    _s = hover_id <= 861 ? 2 : hover_id <= 863 ? 3 : 4;
    sset(_s, (hover_id - 860) % 2); update_params();
  ) :
  (hover_id >= 870 && hover_id <= 872) ? ( sset(8, hover_id - 870); update_params(); ) :
  (hover_id >= 873 && hover_id <= 874) ? ( sset(21, hover_id - 873); update_params(); ) :
  hover_id == 875 ? ( _r = menu_list(3, 8, slider19); _r > 0 ? ( sset(19, _r - 1); update_params(); ); ) :
  (hover_id >= 880 && hover_id <= 882) ? ( sset(22, hover_id - 880); update_params(); ) :
  hover_id == 883 ? ( sset(26, !slider26); update_params(); ) :
  hover_id == 884 ? ( sset(27, !slider27); update_params(); ) :
  hover_id == 885 ? ( _s = CHOP0 + 3 * SEL + 2; sset(_s, !slider(_s)); update_params(); ) :
  (hover_id >= 230 && hover_id <= 234) ? ( sset(38, hover_id - 230); update_params(); ) :
  (hover_id >= 240 && hover_id <= 244) ? ( sset(50, hover_id - 240); update_params(); ) :
  hover_id == 260 ? ( _r = menu_list(2, 4, slider53); _r > 0 ? ( sset(53, _r - 1); update_params(); ); ) :
  hover_id == 262 ? ( sset(52, slider52 ? 0 : 9); update_params(); ) :
  hover_id == 264 ? ( sset(55, !slider55); update_params(); ) :
  hover_id == 300 ? menu_presets() :
  hover_id == 301 ? ( _r = menu_list(1, 3, slider28); _r > 0 ? ( sset(28, _r - 1); update_params(); ); ) :
  hover_id == 403 ? ( pk_l = pk_r = 0; ) :
  hover_id == 600 ? KBO = max(0, KBO - 12) :
  hover_id == 601 ? KBO = min(96, KBO + 12) :
  (hover_id >= 500 && hover_id < 600) ? (
    drag = 1; drag_id = 500; kb_note = hover_id - 500 + KBO; kq(1, kb_note, kb_vel, 0); kb_on = 1;
  );
);
lb && drag ? (
  _k = shift ? 0.1 : 1;
  (drag_id >= 2 && drag_id <= NPARAMS) ? ctl_set(drag_id, drag_n + (drag_my - my) / (200 * SC) * _k) :
  (drag_id >= 701 && drag_id <= 704) ? (
    _p = clamp(x2f(mx) / max(SN, 1) * 100, 0, 100);
    sset(drag_id == 701 ? 5 : drag_id == 702 ? 6 : drag_id == 703 ? 9 : 10, floor(_p * 1000 + 0.5) / 1000); update_params();
  ) :
  drag_id == 1000 && drag_man >= 0 ? (
    MANP[drag_man] = clamp(x2f(mx) / SN, 0, 1); man_sort(); drag_man = -1;
    _i = 0; loop(NMAN, abs(MANP[_i] - clamp(x2f(mx) / SN, 0, 1)) < 0.0000001 ? drag_man = _i; _i += 1; );
    MANVER += 1; update_params();
  ) :
  drag_id == 705 ? ( _w = VZ1 - VZ0; VZ0 = clamp((mx - WFX) / WFW * SN - _w * 0.5, 0, max(0, SN - _w)); VZ1 = VZ0 + _w; ) :
  drag_id == 500 ? (
    _h = hit_find(mx, my);
    (_h >= 500 && _h < 600 && _h - 500 + KBO != kb_note) ? ( kq(1, kb_note, 0, 0); kb_note = _h - 500 + KBO; kq(1, kb_note, kb_vel, 0); );
  );
);
(!lb && drag) ? (
  drag_id == 500 && kb_on ? ( kq(1, kb_note, 0, 0); kb_on = 0; );
  drag_id == 800 ? kq(1, pad_note, 0, 0);
  drag_id == 799 ? kq(3, 0, 0, 0);
  drag = 0;
);
mouse_wheel != 0 ? (
  _w = mouse_wheel / 120;
  (hover_id >= 2 && hover_id <= NPARAMS) ? (
    _s = ksl(hover_id);
    (PSTEP[_s] >= 1 && (PMAX[_s] - PMIN[_s]) <= 48) ? ( ctl_setv(_s, slider(_s) + sign(_w) * PSTEP[_s]); ) :
    ctl_set(hover_id, ctl_get(hover_id) + _w * (shift ? 0.002 : 0.012));
    update_params();
  ) :
  (hover_id == 700 || (hover_id >= 701 && hover_id <= 705) || hover_id >= 1000) && LOADED ? (
    shift ? pan_view(-_w * (VZ1 - VZ0) * 0.1) : zoom_at(clamp(x2f(mx), 0, SN), _w > 0 ? 0.8 ^ _w : 1.25 ^ (-_w));
  );
  mouse_wheel = 0;
);
mouse_hwheel != 0 ? ( LOADED ? pan_view(mouse_hwheel / 120 * (VZ1 - VZ0) * 0.1); mouse_hwheel = 0; );
last_lb = lb; last_rb = rb;
upd ? ( upd = 0; update_params(); );

// ======================================================================= dibujo
hit_n = 0;
gfx_set(0.075, 0.082, 0.105, 1); gfx_rect(0, 0, WW, WH, 1);

// ---- barra superior
gfx_set(0.10, 0.11, 0.14, 1); gfx_rect(0, 0, WW, TOPH, 1);
fnt(3); gfx_set(0.62, 0.80, 1.0, 1); text_l("NUBE", 14 * SC, 0, TOPH);
gfx_measurestr("NUBE ", _tw, _th);
gfx_set(0.93, 0.94, 0.97, 1); text_l("SAMPLER", 14 * SC + _tw, 0, TOPH);
_x = 160 * SC; _y = 9 * SC; _h = 26 * SC;
CUR_PRESET > 0 ? strcpy(#s, preset_name(CUR_PRESET)) : strcpy(#s, "Presets");
dropdown(300, _x, _y, 220 * SC, _h, "", #s); _x += 232 * SC;
setcol(0);
button(860, _x, _y, 64 * SC, _h, "Clasico", !CHOPS); button(861, _x + 66 * SC, _y, 64 * SC, _h, "Chops", CHOPS); _x += 142 * SC;
setcol(7);
button(862, _x, _y, 72 * SC, _h, "Mantener", !ONESHOT); button(863, _x + 74 * SC, _y, 72 * SC, _h, "One-shot", ONESHOT); _x += 158 * SC;
setcol(2);
button(864, _x, _y, 86 * SC, _h, "Remuestreo", !STRETCH); button(865, _x + 88 * SC, _y, 70 * SC, _h, "Estirar", STRETCH); _x += 170 * SC;
_a = 0; _i = 0; loop(MAXV, (V0 + _i * VS)[0] ? _a += 1; _i += 1; );
fnt(2); gfx_set(0.55, 0.58, 0.65, 1);
sprintf(#s, "%d / %d voces", _a, (!CHOPS && VMODE) ? 1 : NV); text_r(#s, WW - 200 * SC, _y, 90 * SC, _h);
LASTN >= 0 ? ( note_str(#n, LASTN); fnt(6); gfx_set(0.62, 0.80, 1.0, 1); text_r(#n, WW - 104 * SC, _y, 90 * SC, _h); );

// ---- barra del sample
setcol(0);
LOADED || MISSING ? strcpy(#s, #sname) : strcpy(#s, "Elegir sample...");
dropdown(852, 14 * SC, sby, 356 * SC, SBH, "Sample", #s);
fnt(2); gfx_set(0.62, 0.65, 0.72, 1);
MISSING ? ( gfx_set(1, 0.45, 0.4, 1); sprintf(#s, "No se encontro el archivo: %s", #spath); ) :
CUR_MSG == 1 && time_precise() - msg_t < 4 ? ( gfx_set(1, 0.45, 0.4, 1); strcpy(#s, "Ese archivo no se pudo leer como audio."); ) :
LOADED ? (
  sprintf(#s, "%.1f kHz  ·  %s  ·  %.2f s", SSR / 1000, SNCH == 1 ? "mono" : SNCH == 2 ? "estereo" : "multicanal (usa 1-2)", SN / SSR);
  DET_NOTE >= 0 ? ( note_str(#n, floor(DET_NOTE + 0.5)); sprintf(#t, "  ·  nota %s %+d c", #n, floor((DET_NOTE - floor(DET_NOTE + 0.5)) * 100 + 0.5)); strcat(#s, #t); )
                : strcat(#s, "  ·  sin nota clara");
  SLONG ? strcat(#s, "  ·  RECORTADO (muy largo)");
) : strcpy(#s, "Arrastra un archivo de audio a la ventana o elige uno en el selector Sample de arriba");
text_l(#s, 380 * SC, sby, SBH);
_x = WW - 14 * SC - 4 * 96 * SC;
setcol(8); button(853, _x, sby, 92 * SC, SBH, "Reverso", slider7); _x += 96 * SC;
setcol(2); button(854, _x, sby, 92 * SC, SBH, "Normalizar", slider61); _x += 96 * SC;
setcol(5); button(855, _x, sby, 92 * SC, SBH, "Afinar", 0); _x += 96 * SC;
setcol(6); button(856, _x, sby, 92 * SC, SBH, SN > EMBMAX && slider62 ? "Muy largo" : "En proyecto", slider62);

// ---- forma de onda
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(WFX, WFY, WFW, WFH, 1);
hit_add(WFX, WFY, WFW, WFVH, 700);
_cy = WFY + WFVH * 0.5 + 6 * SC; _amp = (WFVH - 26 * SC) * 0.5;
LOADED ? (
  _span = VZ1 - VZ0; _fpx = _span / WFW; _bin = SN / PKN;
  // regiones de los chops (alternadas) y seleccion
  CHOPS ? (
    _k = 0;
    loop(NCH,
      _x0 = max(WFX, f2x(CHP[_k])); _x1 = min(WFX + WFW, f2x(CHP[_k + 1]));
      _x1 > _x0 ? (
        _k == SEL ? gfx_set(0.42, 0.78, 1.0, 0.16) : gfx_set(1, 1, 1, _k % 2 ? 0.035 : 0.0);
        gfx_rect(_x0, WFY, _x1 - _x0, WFVH, 1);
        CHPLAY[_k] ? ( gfx_set(1, 0.85, 0.4, 0.14); gfx_rect(_x0, WFY, _x1 - _x0, WFVH, 1); );
      );
      _k += 1;
    );
  );
  // la onda
  _i = 0;
  loop(WFW,
    _fa = VZ0 + _i * _fpx; _fb = _fa + _fpx;
    _fpx >= _bin ? (
      _b0 = floor(_fa / _bin); _b1 = max(_b0 + 1, floor(_fb / _bin)); _mn = 0; _mxv = 0;
      _j = _b0; loop(min(_b1 - _b0, 64), _j < PKN ? ( _mn = min(_mn, PKL[_j]); _mxv = max(_mxv, PKH[_j]); ); _j += 1; );
    ) : _fpx >= 1 ? (
      _j = floor(_fa); _st = max(1, floor(_fpx / 32)); _mn = 0; _mxv = 0;
      while (_j < _fb && _j < SN) ( _v = SMP[2 * _j]; _mn = min(_mn, _v); _mxv = max(_mxv, _v); _v = SMP[2 * _j + 1]; _mn = min(_mn, _v); _mxv = max(_mxv, _v); _j += _st; );
    ) : (
      _j = floor(_fa); _fr = _fa - _j; _v = (smp_at(_j, 0) * (1 - _fr) + smp_at(_j + 1, 0) * _fr + smp_at(_j, 1) * (1 - _fr) + smp_at(_j + 1, 1) * _fr) * 0.5;
      _mn = _mxv = _v;
      _i > 0 ? ( _mn = min(_mn, _pv); _mxv = max(_mxv, _pv); );
      _pv = _v;
    );
    _xx = WFX + _i;
    _in = _fa >= R0 && _fa < R1;
    _in ? gfx_set(0.42, 0.78, 1.0, 0.95) : gfx_set(0.42, 0.50, 0.62, 0.55);
    gfx_line(_xx, _cy - _mxv * _amp, _xx, _cy - _mn * _amp + 1);
    _i += 1;
  );
  gfx_set(1, 1, 1, 0.06); gfx_line(WFX, _cy, WFX + WFW - 1, _cy);
  // zona fuera de la region
  _x0 = f2x(R0); _x0 > WFX ? ( gfx_set(0, 0, 0, 0.35); gfx_rect(WFX, WFY, min(_x0, WFX + WFW) - WFX, WFVH, 1); );
  _x1 = f2x(R1); _x1 < WFX + WFW ? ( gfx_set(0, 0, 0, 0.35); gfx_rect(max(_x1, WFX), WFY, WFX + WFW - max(_x1, WFX), WFVH, 1); );
  // regla de tiempo
  _sec = SN / SSR; _tick = _span / SSR < 2 ? 0.1 : _span / SSR < 10 ? 0.5 : _span / SSR < 40 ? 2 : 10;
  fnt(7); _t = ceil(VZ0 / SSR / _tick) * _tick;
  while (_t * SSR < VZ1) ( _xx = f2x(_t * SSR); gfx_set(1, 1, 1, 0.10); gfx_line(_xx, WFY, _xx, WFY + 5 * SC);
    gfx_set(0.5, 0.53, 0.6, 1); sprintf(#s, _tick < 1 ? "%.1f" : "%d", _t); text_l(#s, _xx + 2 * SC, WFY, 12 * SC); _t += _tick; );
  // cortes de los chops
  CHOPS ? (
    _k = 1;
    loop(NCH - 1,
      _xx = f2x(CHP[_k]);
      (_xx >= WFX && _xx < WFX + WFW) ? (
        _hv = hover_id == 1000 + _k;
        gfx_set(1, 1, 1, _hv ? 0.95 : 0.55); gfx_line(_xx, WFY + 14 * SC, _xx, WFY + WFVH);
        hit_add(_xx - 4 * SC, WFY + 14 * SC, 8 * SC, WFVH - 14 * SC, 1000 + _k);
      );
      _k += 1;
    );
    fnt(4); _k = 0;
    loop(NCH, _xx = f2x(CHP[_k]); (_xx >= WFX - 20 && _xx < WFX + WFW) ? ( gfx_set(0.9, 0.92, 0.96, 0.9); sprintf(#s, "%d", _k + 1); text_l(#s, max(WFX, _xx) + 3 * SC, WFY + 13 * SC, 12 * SC); ); _k += 1; );
  );
  // banderas: inicio / fin arriba, loop abajo
  (!CHOPS && LOOPM && !ONESHOT) ? (
    _x0 = f2x(LPS); _x1 = f2x(LPE); gfx_set(0.93, 0.86, 0.40, 0.08); gfx_rect(max(WFX, _x0), WFY, max(0, min(WFX + WFW, _x1) - max(WFX, _x0)), WFVH, 1);
    flag(703, LPS, "L", 0, 0.93, 0.86, 0.40); flag(704, LPE, "L", 0, 0.93, 0.86, 0.40);
  );
  flag(701, R0, "S", 1, 0.50, 0.92, 0.70); flag(702, R1, "E", 1, 0.97, 0.50, 0.42);
  // cabezales de las voces que suenan
  _v = 0; loop(MAXV, _vb = V0 + _v * VS; _vb[0] ? ( _xx = f2x(_vb[51]); (_xx >= WFX && _xx < WFX + WFW) ? ( gfx_set(1, 1, 1, 0.8 * _vb[14] + 0.2); gfx_line(_xx, WFY + 14 * SC, _xx, WFY + WFVH); ); ); _v += 1; );
  // tira de vista completa
  _oy = WFY + WFH - OVH;
  gfx_set(0.08, 0.09, 0.115, 1); gfx_rect(WFX, _oy, WFW, OVH, 1);
  _i = 0; loop(WFW, _b = floor(_i / WFW * PKN); _mxv = max(PKH[_b], -PKL[_b]); gfx_set(0.42, 0.78, 1.0, 0.45); gfx_line(WFX + _i, _oy + OVH * 0.5 - _mxv * OVH * 0.45, WFX + _i, _oy + OVH * 0.5 + _mxv * OVH * 0.45); _i += 1; );
  gfx_set(1, 1, 1, hover_id == 705 ? 0.30 : 0.18); gfx_rect(WFX + VZ0 / SN * WFW, _oy, max(3 * SC, (VZ1 - VZ0) / SN * WFW), OVH, 1);
  hit_add(WFX, _oy, WFW, OVH, 705);
) : (
  fnt(8); gfx_set(0.55, 0.58, 0.65, 1);
  text_c(MISSING ? "Falta el archivo del sample (arrastralo de nuevo o elige otro)" : "Arrastra un sample aqui", WFX, WFY, WFW, WFH * 0.5 + 10 * SC);
  fnt(2); text_c("o elige uno en el selector Sample de arriba (biblioteca REAPER/Data/Nube Sampler). wav, aif, flac, mp3, ogg", WFX, WFY + WFH * 0.5, WFW, 30 * SC);
);

// medidor de salida
pk_l = max(m_l, pk_l * 0.999); pk_r = max(m_r, pk_r * 0.999);
_ml = m_l; _mr = m_r; m_l *= 0.82; m_r *= 0.82;
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(mtx, WFY, MTW, WFH, 1);
_mt = WFY + 18 * SC; _mh = WFH - 36 * SC; _bw = 8 * SC; _k = 0;
loop(2,
  _xx = mtx + 5 * SC + _k * 11 * SC;
  gfx_set(0.13, 0.14, 0.18, 1); gfx_rect(_xx, _mt, _bw, _mh, 1);
  _pdb = 20 * log10((_k ? _mr : _ml) + 0.000000001); _lv = clamp((_pdb + 60) / 66, 0, 1);
  _pdb > -0.1 ? gfx_set(1, 0.35, 0.3, 1) : _pdb > -6 ? gfx_set(0.95, 0.85, 0.35, 1) : gfx_set(0.42, 0.85, 0.55, 1);
  gfx_rect(_xx, _mt + _mh * (1 - _lv), _bw, _mh * _lv, 1);
  _pk = 20 * log10((_k ? pk_r : pk_l) + 0.000000001);
  gfx_set(1, 1, 1, 0.6); _yy = _mt + _mh * (1 - clamp((_pk + 60) / 66, 0, 1)); gfx_line(_xx, _yy, _xx + _bw - 1, _yy);
  _k += 1;
);
_pk = 20 * log10(max(pk_l, pk_r) + 0.000000001); _pk > -60 ? sprintf(#s, "%.0f", _pk) : strcpy(#s, "-inf");
fnt(7); gfx_set(0.80, 0.82, 0.88, 1); text_c(#s, mtx, WFY + 2 * SC, MTW, 16 * SC);
gfx_set(0.50, 0.53, 0.60, 1); text_c("OUT", mtx, _mt + _mh + 1 * SC, MTW, 16 * SC);
hit_add(mtx, WFY, MTW, WFH, 403);

// ---- secciones
function sec(x, y, w, h, title, c) (
  setcol(c);
  gfx_set(0.10, 0.11, 0.14, 1); frect(x, y, w, h, 6 * SC);
  acc(1); gfx_rect(x + 8 * SC, y + 8 * SC, 3 * SC, 11 * SC, 1);
  fnt(4); acc(1); text_l(title, x + 16 * SC, y + 6 * SC, 14 * SC);
);
function row_layout(n) local(i, t, f)
( t = 0; i = 0; loop(n, t += SW[i]; i += 1; ); f = (WW - 28 * SC - (n - 1) * GAP - t) / n; f < 0 ? f = 0;
  i = 0; loop(n, SW[i] += f; i += 1; ); );
function krow(y) ( y + 56 * SC; );

// fila 1: SAMPLE, LOOP, TIEMPO
SW[0] = 7 * KS + 16 * SC; SW[1] = 3 * KS + 130 * SC; SW[2] = 2 * KS + 150 * SC; row_layout(3);
_x = 14 * SC; _y = r1y; _ky = krow(_y);
_w = SW[0]; sec(_x, _y, _w, RH, "SAMPLE", 0);
_kx = _x + (_w - 7 * KS) * 0.5 + KS * 0.5;
pknob(5, _kx, _ky, KRAD, "Inicio", LOADED); _kx += KS;
pknob(6, _kx, _ky, KRAD, "Fin", LOADED); _kx += KS;
pknob(12, _kx, _ky, KRAD, "Fade in", 1); _kx += KS;
pknob(13, _kx, _ky, KRAD, "Fade out", 1); _kx += KS;
pknob(14, _kx, _ky, KRAD, "Raiz", !CHOPS && KTRK); _kx += KS;
pknob(16, _kx, _ky, KRAD, "Tono", 1); _kx += KS;
pknob(17, _kx, _ky, KRAD, "Fino", 1);
button(857, _x + _w - 8 * SC - 92 * SC, _y + 5 * SC, 92 * SC, 17 * SC, KTRK ? "Sigue teclado" : "Tono fijo", KTRK);
_x += _w + GAP; _w = SW[1]; sec(_x, _y, _w, RH, "LOOP", 5);
_lpon = !CHOPS && !ONESHOT;
_i = 0; loop(3, button(870 + _i, _x + _w - 8 * SC - (3 - _i) * 58 * SC, _y + 5 * SC, 55 * SC, 17 * SC, _i == 0 ? "Off" : _i == 1 ? "Adelante" : "Ping-pong", LOOPM == _i); _i += 1; );
_kx = _x + 12 * SC + KS * 0.5;
pknob(9, _kx, _ky, KRAD, "Inicio L", _lpon && LOOPM); _kx += KS;
pknob(10, _kx, _ky, KRAD, "Fin L", _lpon && LOOPM); _kx += KS;
pknob(11, _kx, _ky, KRAD, "Crossfade", _lpon && LOOPM == 1);
fnt(7); gfx_set(0.55, 0.58, 0.65, 1);
!_lpon ? text_l(CHOPS ? "(no se usa en Chops)" : "(no se usa en One-shot)", _kx + KS * 0.6, _ky - 6 * SC, 12 * SC);
_x += _w + GAP; _w = SW[2]; sec(_x, _y, _w, RH, "TIEMPO", 2);
button(873, _x + _w - 8 * SC - 2 * 54 * SC, _y + 5 * SC, 51 * SC, 17 * SC, "Normal", QUAL == 0);
button(874, _x + _w - 8 * SC - 54 * SC, _y + 5 * SC, 51 * SC, 17 * SC, "Alta", QUAL == 1);
_kx = _x + 12 * SC + KS * 0.5;
pknob(18, _kx, _ky, KRAD, "Velocidad", SYNCN == 0); _kx += KS;
pknob(20, _kx, _ky, KRAD, "Grano", STRETCH);
_dx = _kx + KS * 0.5 + 8 * SC; _dw = _x + _w - 10 * SC - _dx;
dropdown(875, _dx, _y + 32 * SC, _dw, 22 * SC, "A tempo", sync_name(SYNCN));
fnt(7); gfx_set(0.62, 0.65, 0.72, 1);
SYNCN > 0 && LOADED ? ( sprintf(#s, "%.1f BPM del sample", sync_beats(SYNCN) * 60 / ((R1 - R0) / SSR)); text_l(#s, _dx + 4 * SC, _y + 64 * SC, 12 * SC); ) :
LOADED ? ( sprintf(#s, "region: %.2f s", (R1 - R0) / SSR); text_l(#s, _dx + 4 * SC, _y + 64 * SC, 12 * SC); );

// fila 2: CHOPS y pads
SW[0] = 3 * KS + 250 * SC; SW[1] = 8 * 42 * SC + 60 * SC; SW[2] = 2 * KS + 90 * SC; row_layout(3);
_x = 14 * SC; _y = r2y; _ky = krow(_y);
_w = SW[0]; sec(_x, _y, _w, RH, "CHOPS", 7);
_i = 0; loop(3, button(880 + _i, _x + _w - 8 * SC - (3 - _i) * 76 * SC, _y + 5 * SC, 73 * SC, 17 * SC, _i == 0 ? "Transitorios" : _i == 1 ? "Iguales" : "A mano", CDET == _i); _i += 1; );
_kx = _x + 12 * SC + KS * 0.5;
pknob(23, _kx, _ky, KRAD, "Sensib.", CDET == 0); _kx += KS;
pknob(24, _kx, _ky, KRAD, "Partes", CDET == 1); _kx += KS;
pknob(25, _kx, _ky, KRAD, "1a nota", CHOPS);
_bx = _kx + KS * 0.5 + 10 * SC; _bw = _x + _w - 10 * SC - _bx;
button(883, _bx, _y + 30 * SC, _bw, 18 * SC, PLAYTHRU ? "Hasta el final del sample" : "Cada chop hasta su final", PLAYTHRU);
button(884, _bx, _y + 52 * SC, _bw, 18 * SC, CHOKE ? "Choke: uno a la vez" : "Varios a la vez", CHOKE);
fnt(7); gfx_set(0.62, 0.65, 0.72, 1); sprintf(#s, "%d chops", NCH); text_l(#s, _bx, _y + 74 * SC, 14 * SC);
_x += _w + GAP; _w = SW[1]; sec(_x, _y, _w, RH, "PADS", 7);
button(840, _x + _w - 8 * SC - 60 * SC, _y + 5 * SC, 60 * SC, 17 * SC, PADPAGE ? "17 - 32" : "1 - 16", PADPAGE);
_pw = (_w - 24 * SC) / 8; _ph = 31 * SC; _px0 = _x + 12 * SC; _py0 = _y + 26 * SC;
_i = 0;
loop(16,
  _k = _i + PADPAGE * 16; _xx = _px0 + (_i % 8) * _pw; _yy = _py0 + floor(_i / 8) * (_ph + 4 * SC);
  _ex = _k < NCH;
  CHPLAY[_k] && _ex ? gfx_set(1, 0.85, 0.45, 1) : _k == SEL && _ex ? gfx_set(0.42, 0.78, 1.0, 1) :
  gfx_set(hover_id == 800 + _k && _ex ? 0.26 : 0.17, hover_id == 800 + _k && _ex ? 0.28 : 0.19, hover_id == 800 + _k && _ex ? 0.34 : 0.24, _ex ? 1 : 0.4);
  frect(_xx, _yy, _pw - 4 * SC, _ph, 4 * SC);
  (CHPLAY[_k] || _k == SEL) && _ex ? gfx_set(0.07, 0.08, 0.10, 1) : gfx_set(0.86, 0.88, 0.92, _ex ? 1 : 0.35);
  fnt(5); sprintf(#s, "%d", _k + 1); text_l(#s, _xx + 5 * SC, _yy + 1 * SC, 14 * SC);
  fnt(7); note_str(#n, CHB + _k); text_r(#n, _xx, _yy + _ph - 14 * SC, _pw - 9 * SC, 12 * SC);
  _ex ? hit_add(_xx, _yy, _pw - 4 * SC, _ph, 800 + _k);
  _i += 1;
);
_x += _w + GAP; _w = SW[2]; sprintf(#s, "CHOP %d", SEL + 1); sec(_x, _y, _w, RH, #s, 7);
_kx = _x + 12 * SC + KS * 0.5;
pknob(CHOP0 + 3 * SEL, _kx, _ky, KRAD, "Tono", SEL < NCH); _kx += KS;
pknob(CHOP0 + 3 * SEL + 1, _kx, _ky, KRAD, "Ganancia", SEL < NCH);
button(885, _kx + KS * 0.5 + 8 * SC, _y + 40 * SC, _x + _w - 10 * SC - (_kx + KS * 0.5 + 8 * SC), 20 * SC, "Reverso", slider(CHOP0 + 3 * SEL + 2));

// fila 3: FILTRO, AMP, ENV 2
SW[0] = 6 * KS + 16 * SC; SW[1] = 5 * KS + 16 * SC; SW[2] = 5 * KS + 16 * SC; row_layout(3);
_x = 14 * SC; _y = r3y; _ky = krow(_y);
_w = SW[0]; sec(_x, _y, _w, RH, "FILTRO", 3);
_i = 0; loop(5, button(230 + _i, _x + _w - 8 * SC - (5 - _i) * 38 * SC, _y + 5 * SC, 35 * SC, 17 * SC, ft_name(_i), FT == _i); _i += 1; );
_kx = _x + (_w - 6 * KS) * 0.5 + KS * 0.5; _fe = FT < 4;
pknob(39, _kx, _ky, KRAD, "Corte", _fe); _kx += KS;
pknob(40, _kx, _ky, KRAD, "Reso", _fe); _kx += KS;
pknob(41, _kx, _ky, KRAD, "Drive", 1); _kx += KS;
pknob(42, _kx, _ky, KRAD, "Env 2", _fe); _kx += KS;
pknob(48, _kx, _ky, KRAD, "Teclado", _fe); _kx += KS;
pknob(49, _kx, _ky, KRAD, "Velocidad", _fe);
_x += _w + GAP; _w = SW[1]; sec(_x, _y, _w, RH, "AMP", 4);
_kx = _x + (_w - 5 * KS) * 0.5 + KS * 0.5;
pknob(33, _kx, _ky, KRAD, "Ataque", 1); _kx += KS;
pknob(34, _kx, _ky, KRAD, "Decae", 1); _kx += KS;
pknob(35, _kx, _ky, KRAD, "Sostiene", 1); _kx += KS;
pknob(36, _kx, _ky, KRAD, "Relaja", !ONESHOT); _kx += KS;
pknob(37, _kx, _ky, KRAD, "Velocidad", 1);
_x += _w + GAP; _w = SW[2]; sec(_x, _y, _w, RH, "ENV 2", 5);
_kx = _x + (_w - 5 * KS) * 0.5 + KS * 0.5;
pknob(43, _kx, _ky, KRAD, "Ataque", 1); _kx += KS;
pknob(44, _kx, _ky, KRAD, "Decae", 1); _kx += KS;
pknob(45, _kx, _ky, KRAD, "Sostiene", 1); _kx += KS;
pknob(46, _kx, _ky, KRAD, "Relaja", 1); _kx += KS;
pknob(47, _kx, _ky, KRAD, "Tono", 1);

// fila 4: VOZ, LFO, LO-FI, SALIDA
SW[0] = 4 * KS + 16 * SC; SW[1] = 2 * KS + 110 * SC + 16 * SC; SW[2] = 2 * KS + 16 * SC; SW[3] = 3 * KS + 16 * SC; row_layout(4);
_x = 14 * SC; _y = r4y; _ky = krow(_y);
_w = SW[0]; sec(_x, _y, _w, RH, "VOZ", 6);
dropdown(301, _x + _w - 8 * SC - 90 * SC, _y + 4 * SC, 90 * SC, 19 * SC, "", vmode_name(VMODE));
_kx = _x + (_w - 4 * KS) * 0.5 + KS * 0.5;
pknob(29, _kx, _ky, KRAD, "Voces", 1); _kx += KS;
pknob(30, _kx, _ky, KRAD, "Glide", !CHOPS); _kx += KS;
pknob(31, _kx, _ky, KRAD, "Bend", 1); _kx += KS;
pknob(32, _kx, _ky, KRAD, "Vibrato", 1);
_x += _w + GAP; _w = SW[1]; sec(_x, _y, _w, RH, "LFO", 8);
_i = 0; loop(5, button(240 + _i, _x + _w - 8 * SC - (5 - _i) * 30 * SC, _y + 5 * SC, 27 * SC, 17 * SC, lfo_name(_i), LFS == _i); _i += 1; );
_kx = _x + 12 * SC + KS * 0.5;
pknob(51, _kx, _ky, KRAD, "Velocidad", 1); _kx += KS;
pknob(54, _kx, _ky, KRAD, "Cantidad", 1); _kx += KS * 0.5 + 8 * SC;
_pw = _x + _w - 10 * SC - _kx;
dropdown(260, _kx, _y + 28 * SC, _pw, 20 * SC, "", dest_name(LFD));
button(262, _kx, _y + 52 * SC, _pw * 0.5 - 2 * SC, 18 * SC, "A tempo", slider52 > 0);
button(264, _kx + _pw * 0.5 + 2 * SC, _y + 52 * SC, _pw * 0.5 - 2 * SC, 18 * SC, "Nota", LFRT);
_x += _w + GAP; _w = SW[2]; sec(_x, _y, _w, RH, "LO-FI", 9);
_kx = _x + (_w - 2 * KS) * 0.5 + KS * 0.5;
pknob(56, _kx, _ky, KRAD, "Bits", 1); _kx += KS;
pknob(57, _kx, _ky, KRAD, "Muestreo", 1);
_x += _w + GAP; _w = SW[3]; sec(_x, _y, _w, RH, "SALIDA", 10);
_kx = _x + (_w - 3 * KS) * 0.5 + KS * 0.5;
pknob(58, _kx, _ky, KRAD, "Paneo", 1); _kx += KS;
pknob(59, _kx, _ky, KRAD, "Ancho", 1); _kx += KS;
pknob(60, _kx, _ky, KRAD, "Volumen", 1);

// ---- teclado en pantalla (en Chops, las teclas con chop van de color)
setcol(0);
_kx0 = 14 * SC + 76 * SC; _kw = WW - 14 * SC - _kx0;
gfx_set(0.10, 0.11, 0.14, 1); frect(14 * SC, kby, 70 * SC, KBH, 6 * SC);
button(600, 20 * SC, kby + 6 * SC, 26 * SC, 20 * SC, "<", 0);
button(601, 52 * SC, kby + 6 * SC, 26 * SC, 20 * SC, ">", 0);
note_str(#n, KBO); fnt(2); gfx_set(0.70, 0.73, 0.80, 1); text_c(#n, 14 * SC, kby + 28 * SC, 70 * SC, 20 * SC);
function keymapped(n) ( CHOPS ? (n >= CHB && n < CHB + NCH) : 1; );
_nw = 0; _i = 0; loop(37, !is_black(KBO + _i) ? _nw += 1; _i += 1; );
_ww = _kw / _nw; _wx = _kx0; _i = 0;
loop(37,
  _n = KBO + _i;
  !is_black(_n) ? (
    _on = HELD[_n] || (kb_on && kb_note == _n);
    _hv = hover_id == 500 + _i;
    _on ? acc(1) : CHOPS && keymapped(_n) ? gfx_set(_hv ? 0.98 : 0.93, _hv ? 0.88 : 0.80, _hv ? 0.95 : 0.90, 1) :
          gfx_set(_hv ? 0.86 : 0.80, _hv ? 0.88 : 0.82, _hv ? 0.92 : 0.86, CHOPS ? 0.55 : 1);
    gfx_rect(_wx + 1, kby, _ww - 2, KBH, 1);
    (!CHOPS && _n == ROOT) ? ( setcol(5); acc(1); gfx_circle(_wx + _ww * 0.5, kby + KBH - 22 * SC, 3 * SC, 1, 1); setcol(0); );
    (_n % 12 == 0) ? ( note_str(#n, _n); fnt(7); gfx_set(0.35, 0.37, 0.42, 1); text_c(#n, _wx, kby + KBH - 14 * SC, _ww, 12 * SC); );
    hit_add(_wx, kby, _ww, KBH, 500 + _i);
    _wx += _ww;
  );
  _i += 1;
);
_wx = _kx0; _i = 0;
loop(37,
  _n = KBO + _i;
  is_black(_n) ? (
    _on = HELD[_n] || (kb_on && kb_note == _n);
    _bx = _wx - _ww * 0.3; _hv = hover_id == 500 + _i;
    _on ? acc(1) : CHOPS && keymapped(_n) ? gfx_set(0.55, 0.30, 0.45, 1) : gfx_set(_hv ? 0.24 : 0.12, _hv ? 0.25 : 0.13, _hv ? 0.30 : 0.16, 1);
    gfx_rect(_bx, kby, _ww * 0.6, KBH * 0.6, 1);
    hit_add(_bx, kby, _ww * 0.6, KBH * 0.6, 500 + _i);
  ) : _wx += _ww;
  _i += 1;
);
kb_vel = clamp(floor(40 + 87 * (my - kby) / KBH), 1, 127);

// ---- pie
hint_for(hover_id);
gfx_set(0.06, 0.065, 0.085, 1); gfx_rect(0, WH - FOOTH, WW, FOOTH, 1);
fnt(2); gfx_set(0.70, 0.73, 0.80, 1); text_l(#hint, 12 * SC, WH - FOOTH, FOOTH);
