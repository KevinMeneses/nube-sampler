function kill_note(n) local(v, vb) ( v = 0; loop(MAXV, vb = V0 + v * VS; (vb[0] && vb[1] == n && vb[19] != -2) ? vkill(vb); v += 1; ); );
function kill_chops() local(v, vb) ( v = 0; loop(MAXV, vb = V0 + v * VS; (vb[0] && vb[19] >= 0) ? vkill(vb); v += 1; ); );

