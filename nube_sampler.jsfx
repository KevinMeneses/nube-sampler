  n == 7 ? ( sset(2, 1); sset(3, 1); sset(22, 0); sset(27, 1); sset(12, 1); sset(13, 5); ) :
  n == 8 ? ( sset(2, 1); sset(3, 1); sset(22, 1); sset(24, 16); sset(27, 1); sset(12, 1); sset(13, 5); ) :
  n == 9 ? ( sset(2, 1); sset(22, 0); sset(33, 5); sset(36, 120); sset(13, 5); ) :
  n == 10 ? ( sset(2, 1); sset(3, 1); sset(4, 1); sset(19, 5); sset(22, 1); sset(24, 16); sset(27, 1); sset(13, 5); ) :
