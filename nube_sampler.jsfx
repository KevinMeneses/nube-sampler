options:gfx_hz=60 no_meter maxmem=33554432

@init
ext_noinit = 1;
gfx_ext_retina = 1;
NPARAMS = 158; PRESET_SLIDER = 159; NPRESETS = 16; CHOP0 = 63; MAXCH = 32; RD0 = 160;

// ---------------------------------------------------------------- memoria
MAXV = 24; VS = 64; V0 = 0;            // voces fisicas (las de mas sirven para los fundidos de 3 ms al cortar)
CR = 8;                                 // tasa de control (muestras)
PMIN = 3000; PMAX = 3200; PDEF = 3400; PSTEP = 3600; PUNIT = 3800; PCUR = 4000;
STK = 4300; STV = 4400; HELD = 4500;                 // pila de notas (mono) y teclas apretadas
Q = 4700; QMAX = 512;                                // cola MIDI del bloque (4 por evento)
KQT = 6800; KQN = 6900; KQV = 7000; KQP = 7100;      // eventos de la interfaz (tipo, nota, velocidad, posicion)
hitmem = 7300;                                       // 200 zonas x 5
CHP = 8400; MANP = 8500; CTN = 8600; CGN = 8650; CRV = 8700; CHPLAY = 8750;
SW = 8800; WSX = 8850;
PKN = 4096; PKL = 9000; PKH = PKL + PKN;            // forma de onda resumida (min / max)
SKW = 12; SKR = 2048; SKT = 17500; SKN = 2 * SKW * SKR;   // kernel sinc (Kaiser), media anchura 12, 2048 fases por muestra
WSM = 66700;                                         // zona de busqueda del WSOLA (9000)
ODF = 76000; MAXODF = 120000;                        // energia por bloque (deteccion de transitorios)
ZT = 196500; ZF = 16; MAXZ = 64; ZSTR = 200;         // zonas: tabla (ZF campos por zona) y nombres en los strings 200..263
ZTB = 197600;                                        // copia de la tabla (al reabrir)
TMP = 200000; TMPN = 600000;                         // lectura del archivo por partes
SMP = 800000;                                        // el sample (o las zonas, una tras otra), estereo intercalado
MAXF = floor((33554432 - SMP - 64) / 2);
PADZ = 64;                                           // frames en cero entre zonas: la lectura (sinc 48 puntos) no pisa la vecina
VZONE = -1;
// campos de una zona: 0 inicio (frame en SMP), 1 frames, 2 nota raiz, 3 desde, 4 hasta, 5 vel min, 6 vel max,
// 7 frecuencia de muestreo, 8 canales, 9 afinacion (cents), 10 nota del nombre (-1 = detectada)

// ---------------------------------------------------------------- utilidades
function clamp(x, a, b) ( x < a ? a : x > b ? b : x );
function nlog(v, a, b) ( log(v / a) / log(b / a) );
function dlog(n, a, b) ( a * (b / a) ^ n );
function sat(x) ( x = clamp(x, -3, 3); x * (27 + x * x) / (27 + 9 * x * x); );

function sset(i, v)
(
